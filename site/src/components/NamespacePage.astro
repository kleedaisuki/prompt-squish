---
import ProductShell from "../layouts/ProductShell.astro";
import { messages, type Locale } from "../i18n/messages";
import { namespaceUri, paths } from "../i18n/routes";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const n = messages[locale].reference.ns;
const groups = [
  { key: "roots" as const, names: ["module", "entry"] },
  { key: "composition" as const, names: ["import", "macro", "param", "expand"] },
  { key: "content" as const, names: ["arg", "fill", "slot", "insert"] },
  { key: "control" as const, names: ["ifr"] },
];
const example = `<xs:entry xmlns:xs="${namespaceUri}">\n  <Prompt>Hello, xmlsquish.</Prompt>\n</xs:entry>`;
const resources = [
  { href: "/ns/dsl.md", kind: "Markdown", rel: "describedby" },
  { href: "https://github.com/kleedaisuki/prompt-squish/tree/main/examples", kind: "GitHub" },
  { href: paths[locale].releases, kind: "Product" },
  { href: "/ns/0.3.0/dsl.md", kind: "Snapshot" },
  { href: "/ns/0.2.0/dsl.md", kind: "Snapshot" },
  { href: "https://www.w3.org/TR/REC-xml-names/", kind: "W3C" },
  { href: "/LICENSE.txt", kind: "GPL-3.0", rel: "license" },
];
---
<ProductShell locale={locale} page="namespace" title={n.title} description={n.description}>
  <Fragment slot="head"><link rel="describedby" href="/ns/dsl.md" type="text/markdown" /><link rel="version-history" href={paths[locale].releases} /></Fragment>
  <main id="main" class="namespace-page">
    <header class="namespace-hero product-width">
      <div><p class="eyebrow">{n.eyebrow}</p><h1>{n.heading}</h1><p class="lead">{n.lead}</p></div>
      <namespace-identity class="identity-card">
        <div class="identity-head"><span>{n.status}</span><span aria-hidden="true">◎</span></div>
        <p>{n.name}</p><code data-namespace-uri>{namespaceUri}</code>
        <button type="button" data-copy hidden>{n.copy}<span aria-hidden="true">⧉</span></button>
        <span class="copy-status" data-copy-status role="status" aria-live="polite"></span>
      </namespace-identity>
    </header>

    <section class="namespace-section use-band" aria-labelledby="use-title">
      <div class="product-width use-layout"><div><p class="eyebrow">XML</p><h2 id="use-title">{n.useTitle}</h2><p>{n.useBody}</p></div><pre><code>{example}</code></pre></div>
    </section>

    <section class="namespace-section product-width" aria-labelledby="vocabulary-title">
      <div class="section-heading"><p class="eyebrow">{n.vocabularyEyebrow}</p><h2 id="vocabulary-title">{n.vocabularyTitle}</h2><p>{n.vocabularyBody}</p></div>
      <namespace-explorer>
        <div class="search-row" data-search-ui hidden><label for="directive-search">{locale === "zh-CN" ? "筛选指令" : "Filter directives"}</label><input id="directive-search" type="search" autocomplete="off" placeholder={locale === "zh-CN" ? "输入名称或契约…" : "Search names or contracts…"} data-search /><output data-count aria-live="polite"></output></div>
        <div class="vocabulary-groups">
          {groups.map((group) => <section class="vocabulary-group" data-group><header><span>{String(groups.indexOf(group) + 1).padStart(2, "0")}</span><h3>{n.groupLabels[group.key]}</h3></header><div class="directive-grid">{group.names.map((name) => <article id={name} data-directive data-search-text={`${name} ${n.elements[name]}`}><a class="directive-anchor" href={`#${name}`} aria-label={`xs:${name}`}><span aria-hidden="true">#</span></a><code>xs:{name}</code><p>{n.elements[name]}</p></article>)}</div></section>)}
        </div>
        <p class="empty-state" data-empty hidden>{locale === "zh-CN" ? "没有匹配的指令。" : "No directives match."}</p>
      </namespace-explorer>
    </section>

    <section class="namespace-section pipeline-band" aria-labelledby="pipeline-title">
      <div class="product-width"><div class="section-heading"><p class="eyebrow">{n.pipelineEyebrow}</p><h2 id="pipeline-title">{n.pipelineTitle}</h2><p>{n.pipelineBody}</p></div><ol class="pipeline"><li><small>01</small><strong>XML</strong><span>source closure</span></li><li><small>02</small><strong>XSIR</strong><span>validate + lower</span></li><li><small>03</small><strong>link</strong><span>symbols + relocations</span></li><li><small>04</small><strong>.prompt</strong><span>+ .xsir / .psdbg</span></li></ol><aside><span aria-hidden="true">⌁</span><div><h3>{n.validationTitle}</h3><p>{n.validationBody}</p></div></aside></div>
    </section>

    <section class="namespace-section product-width" aria-labelledby="resources-title">
      <div class="section-heading"><p class="eyebrow">{n.resourcesEyebrow}</p><h2 id="resources-title">{n.resourcesTitle}</h2></div>
      <div class="resource-grid">{resources.map((resource, index) => <a class="resource-card" href={resource.href} rel={resource.rel}><span>{resource.kind}</span><h3>{n.resources[index].title}</h3><p>{n.resources[index].body}</p><b aria-hidden="true">↗</b></a>)}</div>
      <div class="version-panel"><h2>{n.versionTitle}</h2><div>{n.versionRows.map((row) => <article><span>{row.label}</span><code>{row.value}</code><p>{row.body}</p></article>)}</div></div>
    </section>
  </main>
</ProductShell>

<script is:inline>
  /** Progressive clipboard control; static identity remains useful without JavaScript.
   * 渐进式剪贴板控件；无 JavaScript 时静态身份仍然可用。 */
  class NamespaceIdentity extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("[data-copy]");
      const value = this.querySelector("[data-namespace-uri]");
      const status = this.querySelector("[data-copy-status]");
      if (!(button instanceof HTMLButtonElement) || !value || !status || !navigator.clipboard) return;
      button.hidden = false;
      button.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(value.textContent || ""); status.textContent = button.dataset.copied || ""; }
        catch {
          // Select the immutable URI so denial never turns into a dead end.
          // 选中不可变 URI，确保剪贴板拒绝不会形成死路。
          const selection = window.getSelection();
          const range = document.createRange();
          range.selectNodeContents(value);
          selection?.removeAllRanges();
          selection?.addRange(range);
          status.textContent = button.dataset.denied || "";
        }
      });
    }
  }
  /** Client-side filter over the complete server-rendered directive catalog.
   * 在服务端完整渲染的指令目录上提供客户端筛选。 */
  class NamespaceExplorer extends HTMLElement {
    connectedCallback() {
      const ui = this.querySelector("[data-search-ui]");
      const input = this.querySelector("[data-search]");
      const count = this.querySelector("[data-count]");
      const empty = this.querySelector("[data-empty]");
      const cards = [...this.querySelectorAll("[data-directive]")];
      if (!(ui instanceof HTMLElement) || !(input instanceof HTMLInputElement) || !(count instanceof HTMLOutputElement)) return;
      ui.hidden = false;
      const update = () => {
        const query = input.value.trim().toLocaleLowerCase();
        let visible = 0;
        cards.forEach((card) => { const match = !query || (card.getAttribute("data-search-text") || "").toLocaleLowerCase().includes(query); card.toggleAttribute("hidden", !match); if (match) visible += 1; });
        this.querySelectorAll("[data-group]").forEach((group) => group.toggleAttribute("hidden", !group.querySelector("[data-directive]:not([hidden])")));
        count.textContent = `${visible} / ${cards.length}`;
        empty?.toggleAttribute("hidden", visible !== 0);
      };
      input.addEventListener("input", update);
      input.addEventListener("keydown", (event) => { if (event.key === "Escape" && input.value) { input.value = ""; update(); } });
      update();
    }
  }
  if (!customElements.get("namespace-identity")) customElements.define("namespace-identity", NamespaceIdentity);
  if (!customElements.get("namespace-explorer")) customElements.define("namespace-explorer", NamespaceExplorer);
  document.querySelectorAll("namespace-identity [data-copy]").forEach((button) => {
    const zh = document.documentElement.lang === "zh-CN";
    button.dataset.copied = zh ? "URI 已复制" : "URI copied";
    button.dataset.denied = zh ? "无法访问剪贴板；URI 已选中，请手动复制。" : "Clipboard unavailable; the URI is selected for manual copy.";
  });
</script>

<style>
  [hidden]{display:none!important}.eyebrow{margin:0;color:var(--moe-accent-strong);font:800 .7rem var(--moe-font-family-mono,monospace);letter-spacing:.11em;text-transform:uppercase}.namespace-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(20rem,.8fr);align-items:center;gap:clamp(2.5rem,7vw,7rem);padding-block:clamp(4rem,8vw,7rem)}h1{margin:.8rem 0 1.3rem;font-size:clamp(3rem,6vw,5.7rem);line-height:.96;letter-spacing:-.065em}.lead{max-width:44rem;font-size:clamp(1.04rem,2vw,1.2rem);line-height:1.75}.identity-card{display:grid;gap:.8rem;padding:1.4rem;min-width:0;border:1px solid color-mix(in srgb,var(--moe-accent) 40%,var(--xs-line));border-radius:var(--moe-radius-lg,1rem);background:var(--xs-glow);box-shadow:0 1.5rem 4rem #24120910}.identity-head{display:flex;justify-content:space-between;color:var(--moe-accent-strong);font:800 .68rem var(--moe-font-family-mono,monospace);text-transform:uppercase}.identity-card p{margin:.5rem 0 0;color:var(--moe-text-soft);font-size:.78rem}.identity-card code{padding:1rem;overflow-wrap:anywhere;border-radius:var(--moe-radius-sm,.5rem);color:var(--xs-code-text);background:var(--xs-code);font-size:.78rem;user-select:all}.identity-card button{justify-self:start;min-height:2.6rem;padding:.55rem .8rem;border:1px solid var(--moe-accent);border-radius:var(--moe-radius-sm,.5rem);color:var(--moe-accent-strong);background:var(--moe-background);font-weight:800;cursor:pointer}.identity-card button:hover{background:var(--moe-accent-wash)}.copy-status{min-height:1em;color:var(--moe-accent-strong);font-size:.72rem}.namespace-section{padding-block:clamp(3.5rem,7vw,6rem)}.use-band,.pipeline-band{border-block:1px solid var(--xs-line);background:color-mix(in srgb,var(--moe-surface) 72%,transparent)}.use-layout{display:grid;grid-template-columns:.75fr 1.25fr;align-items:center;gap:clamp(2rem,6vw,6rem)}.use-layout h2,.section-heading h2,.version-panel h2{margin:.65rem 0 1rem;font-size:clamp(2rem,4.5vw,3.5rem);line-height:1.06;letter-spacing:-.045em}.use-layout p,.section-heading>p:last-child{line-height:1.75}.use-layout pre{margin:0;padding:1.4rem;overflow-x:auto;border:1px solid #fff2;border-radius:var(--moe-radius-lg,1rem);color:var(--xs-code-text);background:var(--xs-code);box-shadow:0 1.5rem 4rem #24120910}.section-heading{max-width:51rem;margin-bottom:2rem}.search-row{display:grid;grid-template-columns:auto minmax(12rem,28rem) auto;align-items:center;gap:1rem;margin-bottom:2rem;padding:1rem;border:1px solid var(--xs-line);border-radius:var(--moe-radius-md,.75rem);background:var(--moe-surface)}.search-row label{font-weight:800}.search-row input{min-height:2.65rem;padding:.6rem .8rem;border:1px solid var(--xs-line);border-radius:.5rem;color:var(--moe-text);background:var(--moe-background);font:inherit}.search-row output{color:var(--moe-accent-strong);font:800 .72rem var(--moe-font-family-mono,monospace)}.vocabulary-groups{display:grid;gap:2.4rem}.vocabulary-group>header{display:flex;align-items:baseline;gap:.8rem;margin-bottom:.8rem}.vocabulary-group>header span{color:var(--moe-accent-strong);font:800 .7rem var(--moe-font-family-mono,monospace)}.vocabulary-group h3{margin:0;font-size:1.25rem}.directive-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.directive-grid article{position:relative;min-width:0;scroll-margin-top:8rem;padding:1.2rem;border:1px solid var(--xs-line);border-radius:var(--moe-radius-md,.75rem);background:color-mix(in srgb,var(--moe-surface) 70%,transparent)}.directive-grid article:target{border-color:var(--moe-accent);box-shadow:0 0 0 4px var(--xs-glow)}.directive-grid code{color:var(--moe-accent-strong);font-weight:800}.directive-grid p{margin:.65rem 0 0;color:var(--moe-text-soft);line-height:1.6}.directive-anchor{position:absolute;top:.75rem;right:.75rem;display:grid;place-items:center;width:2rem;height:2rem;border-radius:50%;color:var(--moe-text-soft);font-weight:900}.directive-anchor:hover{color:var(--moe-accent-strong);background:var(--moe-accent-wash)}.empty-state{padding:2rem;text-align:center;border:1px dashed var(--xs-line);border-radius:var(--moe-radius-md,.75rem)}.pipeline{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:2rem 0;padding:0;list-style:none;overflow:hidden;border:1px solid #fff2;border-radius:var(--moe-radius-lg,1rem);color:var(--xs-code-text);background:var(--xs-code)}.pipeline li{display:grid;gap:.35rem;padding:1.25rem;border-right:1px solid #fff2}.pipeline li:last-child{border:0}.pipeline small{opacity:.5}.pipeline strong{font-size:1.25rem}.pipeline span{font-size:.75rem;opacity:.7}.pipeline-band aside{display:grid;grid-template-columns:auto 1fr;gap:1rem;padding:1.3rem;border-left:.3rem solid var(--moe-accent-strong);border-radius:0 .75rem .75rem 0;background:var(--xs-glow)}.pipeline-band aside>span{color:var(--moe-accent-strong);font-size:2rem}.pipeline-band aside h3{margin:0}.pipeline-band aside p{margin:.5rem 0 0;line-height:1.65}.resource-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.resource-card{position:relative;display:block;min-height:10rem;padding:1.3rem;border:1px solid var(--xs-line);border-radius:var(--moe-radius-md,.75rem);color:var(--moe-heading);background:color-mix(in srgb,var(--moe-surface) 72%,transparent)}.resource-card>span{color:var(--moe-accent-strong);font:800 .68rem var(--moe-font-family-mono,monospace);text-transform:uppercase}.resource-card h3{margin:.8rem 0 .45rem}.resource-card p{margin:0;color:var(--moe-text-soft);font-size:.85rem;line-height:1.55}.resource-card b{position:absolute;right:1rem;top:1rem;color:var(--moe-accent-strong)}.resource-card:hover{border-color:var(--moe-accent);background:var(--moe-accent-wash);box-shadow:0 .6rem 1.5rem #2412090c;transform:translateY(-2px)}.version-panel{margin-top:clamp(3rem,6vw,5rem);padding:clamp(1.5rem,4vw,3rem);border-radius:var(--moe-radius-lg,1rem);color:var(--xs-code-text);background:var(--xs-code)}.version-panel h2{max-width:35rem;margin-top:0;color:inherit}.version-panel>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:#fff2}.version-panel article{min-width:0;padding:1rem;background:var(--xs-code)}.version-panel span{display:block;margin-bottom:.6rem;font-size:.7rem;opacity:.65}.version-panel code{overflow-wrap:anywhere;font-size:.72rem}.version-panel p{font-size:.8rem;line-height:1.6;opacity:.78}@media(max-width:850px){.namespace-hero,.use-layout{grid-template-columns:1fr}.directive-grid,.resource-grid{grid-template-columns:1fr 1fr}.pipeline{grid-template-columns:1fr 1fr}.pipeline li:nth-child(2){border-right:0}.pipeline li:nth-child(-n+2){border-bottom:1px solid #fff2}.version-panel>div{grid-template-columns:1fr}.search-row{grid-template-columns:1fr auto}.search-row label{grid-column:1/-1}}@media(max-width:560px){.namespace-hero{padding-block:3rem}.directive-grid,.resource-grid,.pipeline{grid-template-columns:1fr}.pipeline li{border-right:0;border-bottom:1px solid #fff2}.search-row{grid-template-columns:1fr}.resource-card{min-height:auto}.identity-card code{font-size:.68rem}}@media(prefers-reduced-motion:reduce){.resource-card:hover{transform:none}}
</style>
