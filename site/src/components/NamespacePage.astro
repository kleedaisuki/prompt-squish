---
import ManualLayout from "../layouts/ManualLayout.astro";
import { type Locale } from "../i18n/messages";
import { namespaceUri, paths } from "../i18n/routes";
import { directives, dslResources, manualChapters, type ManualChapter } from "../data/dsl";
import { manualMessages } from "../i18n/manual";

/** Render the manual overview or one task-oriented chapter.
 * 渲染手册总览或一个面向任务的章节。
 */
interface Props { locale: Locale; chapter?: ManualChapter; }
const { locale, chapter } = Astro.props;
const m = manualMessages[locale];
const other: Locale = locale === "zh-CN" ? "en" : "zh-CN";
const manualPath = (targetLocale: Locale, target?: ManualChapter) => {
  const root = paths[targetLocale].namespace;
  return target ? `${root.replace(/\/$/, "")}/${target}/` : root;
};
const canonicalPath = manualPath(locale, chapter);
const alternatePaths = { "zh-CN": manualPath("zh-CN", chapter), en: manualPath("en", chapter) };
const activeIndex = chapter ? manualChapters.indexOf(chapter) : -1;
const previous = activeIndex > 0 ? manualChapters[activeIndex - 1] : undefined;
const next = activeIndex >= 0 && activeIndex < manualChapters.length - 1 ? manualChapters[activeIndex + 1] : undefined;
const title = chapter ? `${m.chapters[chapter].title} — ${m.title}` : m.title;
const chapterLinks = manualChapters.map((slug, index) => ({ href: manualPath(locale, slug), label: m.chapters[slug].nav, index: String(index + 1).padStart(2, "0"), current: chapter === slug }));
const tocByChapter: Partial<Record<ManualChapter, ReadonlyArray<{ href: `#${string}`; label: string }>>> = {
  "getting-started": [{ href: "#bind", label: locale === "zh-CN" ? "绑定命名空间" : "Bind the namespace" }, { href: "#project", label: locale === "zh-CN" ? "声明构建目标" : "Declare a target" }, { href: "#build", label: locale === "zh-CN" ? "构建并检查" : "Build and inspect" }],
  "source-model": [{ href: "#roots", label: locale === "zh-CN" ? "两种源码根" : "Two source roots" }, { href: "#module", label: locale === "zh-CN" ? "定义模块" : "Define a module" }, { href: "#imports", label: locale === "zh-CN" ? "导入" : "Imports" }],
  composition: [{ href: "#contracts", label: locale === "zh-CN" ? "显式调用契约" : "Explicit contracts" }, { href: "#strings", label: locale === "zh-CN" ? "字符串参数" : "String parameters" }, { href: "#content", label: locale === "zh-CN" ? "结构化内容" : "Structured content" }],
  "control-and-scope": [{ href: "#matching", label: locale === "zh-CN" ? "条件匹配" : "Conditional matching" }, { href: "#bindings", label: locale === "zh-CN" ? "只读绑定域" : "Read-only bindings" }, { href: "#escaping", label: locale === "zh-CN" ? "输出转义" : "Output escaping" }],
  "build-and-artifacts": [{ href: "#pipeline", label: locale === "zh-CN" ? "构建管线" : "Build pipeline" }, { href: "#target-anatomy", label: locale === "zh-CN" ? "项目构建根" : "Project build root" }, { href: "#artifacts", label: locale === "zh-CN" ? "产物角色" : "Artifact roles" }, { href: "#validation", label: locale === "zh-CN" ? "验证边界" : "Validation boundary" }],
  reference: directives.map((directive) => ({ href: `#${directive.name}` as `#${string}`, label: `xs:${directive.name}` })),
  "limits-and-invariants": [{ href: "#budgets", label: locale === "zh-CN" ? "资源预算" : "Resource budgets" }, { href: "#invariants", label: locale === "zh-CN" ? "语言不变量" : "Language invariants" }, { href: "#resources", label: m.resourcesTitle }],
};
const previousChapter = previous ? { href: manualPath(locale, previous), label: m.chapters[previous].nav } : chapter ? { href: manualPath(locale), label: locale === "zh-CN" ? "DSL 用户手册" : "DSL user manual" } : undefined;
const nextChapter = next ? { href: manualPath(locale, next), label: m.chapters[next].nav } : undefined;
const quickExample = `<xs:entry xmlns:xs="${namespaceUri}">
  <Prompt>Hello, xmlsquish.</Prompt>
</xs:entry>`;
const moduleExample = `<xs:module xmlns:xs="${namespaceUri}"
           xmlns:app="urn:example:app">
  <xs:macro name="app:greeting">
    <xs:param name="name"/>
    <Hello><xs:insert get="arg.name"/></Hello>
  </xs:macro>
</xs:module>`;
const entryExample = `<xs:entry xmlns:xs="${namespaceUri}"
          xmlns:app="urn:example:app">
  <xs:import src="./macros.xml"/>
  <xs:expand ref="app:greeting">
    <xs:arg name="name" value="Klee"/>
  </xs:expand>
</xs:entry>`;
const contentExample = `<xs:macro name="app:panel">
  <Panel><xs:slot name="body" required="true"/></Panel>
</xs:macro>

<xs:expand ref="app:panel">
  <xs:fill name="body"><Message>Hello</Message></xs:fill>
</xs:expand>`;
const controlExample = `<xs:ifr get="arg.value" pattern="^(?&lt;head&gt;.)(?&lt;tail&gt;.*)$">
  <xs:insert get="match.head"/>
</xs:ifr>`;
---
<ManualLayout locale={locale} {title} description={chapter ? m.chapters[chapter].intro : m.description} {canonicalPath} {alternatePaths} languageSwitchHref={alternatePaths[other]}
  eyebrow={m.eyebrow} heading={chapter ? m.chapters[chapter].title : m.heading} lead={chapter ? m.chapters[chapter].intro : m.lead}
  treeLabel={locale === "zh-CN" ? "手册章节" : "Manual chapters"} mobileLabel={m.jump} overviewLabel={locale === "zh-CN" ? "手册总览" : "Manual overview"}
  specificationLabel={locale === "zh-CN" ? "阅读完整规范 ↗" : "Full specification ↗"} specificationHref="/ns/dsl.md"
  chapters={chapterLinks} toc={chapter ? tocByChapter[chapter] : []} tocLabel={locale === "zh-CN" ? "本页目录" : "On this page"}
  previous={previousChapter} next={nextChapter} previousLabel={locale === "zh-CN" ? "上一章" : "Previous"} nextLabel={locale === "zh-CN" ? "下一章" : "Next"}
  paginationLabel={locale === "zh-CN" ? "章节翻页" : "Chapter pagination"} richIdentity={!chapter}>
  {!chapter && <namespace-identity slot="identity" class="uri-panel"><span class="status">{m.status}</span><span>{m.uriLabel}</span><code data-namespace-uri>{namespaceUri}</code><button type="button" data-copy hidden data-copied={m.copied} data-denied={m.denied}>{m.copy}<span aria-hidden="true">⧉</span></button><span class="copy-status" data-copy-status role="status" aria-live="polite"></span></namespace-identity>}
        {!chapter && <>
          <section class="overview-start" aria-labelledby="overview-start-title"><div><p class="section-kicker">01 · START</p><h2 id="overview-start-title">{m.chapters["getting-started"].title}</h2><p>{m.chapters["getting-started"].intro}</p><p class="callout">{m.notes.exactUri}</p><a class="chapter-cta" href={manualPath(locale, "getting-started")}>{locale === "zh-CN" ? "开始教程" : "Start the tutorial"}<span aria-hidden="true">→</span></a></div><pre><code>{quickExample}</code></pre></section>
          <section aria-labelledby="chapters-title"><p class="section-kicker">{locale === "zh-CN" ? "学习路径" : "LEARNING PATH"}</p><h2 id="chapters-title">{locale === "zh-CN" ? "按工作流程阅读" : "Read in workflow order"}</h2><div class="chapter-cards">{manualChapters.map((slug, index) => <a href={manualPath(locale, slug)}><span>{String(index + 1).padStart(2, "0")}</span><h3>{m.chapters[slug].nav}</h3><p>{m.chapters[slug].intro}</p><b aria-hidden="true">→</b></a>)}</div></section>
          <section class="boundary"><h2>{locale === "zh-CN" ? "先记住三条边界" : "Three boundaries to remember"}</h2><div><p><strong>entry ≠ module</strong>{m.notes.roots}</p><p><strong>string ≠ XML</strong>{m.notes.values}</p><p><strong>namespace ≠ release</strong>{m.notes.version}</p></div></section>
        </>}

        {chapter === "getting-started" && <>
          <section><h2 id="bind">{locale === "zh-CN" ? "1. 绑定命名空间" : "1. Bind the namespace"}</h2><p>{m.notes.exactUri}</p><pre><code>{quickExample}</code></pre></section>
          <section><h2 id="project">{locale === "zh-CN" ? "2. 声明构建目标" : "2. Declare a build target"}</h2><p>{locale === "zh-CN" ? "在项目根目录创建 xmlsquish.toml，让 target 的 entry 指向这个 XML 文件。" : "Create xmlsquish.toml at the project root and point the target entry at this XML file."}</p><pre><code>{`manifest-version = 1

[package]
name = "hello"
version = "1.0.0"
source-root = "."

[target.prompt]
entry = "prompt.xml"`}</code></pre></section>
          <section><h2 id="build">{locale === "zh-CN" ? "3. 保存、构建并检查" : "3. Save, build, and inspect"}</h2><p>{locale === "zh-CN" ? "把上面的入口保存为 prompt.xml，然后从项目根构建并通过逻辑产物定位符读取原始结果。" : "Save the entry above as prompt.xml, then build from the project root and read the raw result through its logical artifact locator."}</p><pre><code>{`xmlsquish build --target prompt
xmlsquish inspect artifact target/xmlsquish/artifacts/prompt.prompt --format=raw`}</code></pre><p>{locale === "zh-CN" ? "预期输出：" : "Expected output:"}</p><pre><code>{`<Prompt>Hello, xmlsquish.</Prompt>`}</code></pre><p class="callout">{locale === "zh-CN" ? "公共契约是 target/xmlsquish/artifacts/prompt.prompt 这一逻辑定位符，而不是发布器内部的物理存储路径。" : "The public contract is the logical locator target/xmlsquish/artifacts/prompt.prompt—not the publisher's internal physical storage path."}</p></section>
        </>}

        {chapter === "source-model" && <>
          <section><h2 id="roots">{locale === "zh-CN" ? "两种源码根" : "Two source roots"}</h2><p>{m.notes.roots}</p><div class="compare"><div><code>xs:entry</code><p>{m.directives.entry.detail}</p></div><div><code>xs:module</code><p>{m.directives.module.detail}</p></div></div></section>
          <section><h2 id="module">{locale === "zh-CN" ? "定义一个模块" : "Define a module"}</h2><pre><code>{moduleExample}</code></pre></section>
          <section><h2 id="imports">{locale === "zh-CN" ? "从入口导入" : "Import from the entry"}</h2><p>{m.notes.imports}</p><pre><code>{entryExample}</code></pre></section>
        </>}

        {chapter === "composition" && <>
          <section><h2 id="contracts">{locale === "zh-CN" ? "显式调用契约" : "Explicit call contracts"}</h2><p>{m.notes.evaluation}</p><pre><code>{entryExample}</code></pre></section>
          <section><h2 id="strings">{locale === "zh-CN" ? "字符串参数" : "String parameters"}</h2><p>{m.directives.arg.detail}</p><ul><li><code>value="literal"</code></li><li><code>get="arg.other"</code></li><li>{locale === "zh-CN" ? "只产生文本的求值正文" : "an evaluated body that produces text only"}</li></ul></section>
          <section><h2 id="content">{locale === "zh-CN" ? "结构化内容" : "Structured content"}</h2><p>{m.notes.values}</p><pre><code>{contentExample}</code></pre></section>
        </>}

        {chapter === "control-and-scope" && <>
          <section><h2 id="matching">{locale === "zh-CN" ? "条件匹配" : "Conditional matching"}</h2><p>{m.notes.control}</p><pre><code>{controlExample}</code></pre></section>
          <section><h2 id="bindings">{locale === "zh-CN" ? "三个只读绑定域" : "Three read-only binding domains"}</h2><div class="term-table"><div><code>file.*</code><p>{locale === "zh-CN" ? "宏定义所在源码的信息。" : "Information about the macro definition source."}</p></div><div><code>arg.*</code><p>{locale === "zh-CN" ? "本次调用显式传入的字符串。" : "Strings explicitly passed to this invocation."}</p></div><div><code>match.*</code><p>{locale === "zh-CN" ? "当前 ifr 词法块的命名捕获。" : "Named captures in the current ifr lexical block."}</p></div></div></section>
          <section><h2 id="escaping">{locale === "zh-CN" ? "输出始终转义" : "Output is always escaped"}</h2><p>{m.notes.values}</p></section>
        </>}

        {chapter === "build-and-artifacts" && <>
          <section><h2 id="pipeline">{locale === "zh-CN" ? "构建管线" : "Build pipeline"}</h2><p>{m.chapters[chapter].intro}</p><ol class="pipeline"><li><b>01</b><strong>source closure</strong><span>resolve + freeze</span></li><li><b>02</b><strong>XSIR</strong><span>validate + lower</span></li><li><b>03</b><strong>link</strong><span>symbols + relocations</span></li><li><b>04</b><strong>publish</strong><span>.prompt + evidence</span></li></ol></section>
          <section><h2 id="target-anatomy">{locale === "zh-CN" ? "项目拥有完整构建根" : "The project owns the complete build root"}</h2><p>{locale === "zh-CN" ? "默认 target-dir 是 target/xmlsquish。产品、可重建缓存与编译元数据一起移动；cache/ 与 metadata/ 由工具管理，不能依赖其中的散列、数据库或 journal 作为 API。" : "The default target-dir is target/xmlsquish. Products, rebuild caches, and compiler metadata move together; cache/ and metadata/ are tool-managed, so their hashes, database, and journals are not APIs."}</p><pre><code>{`target/xmlsquish/
├── artifacts/              # *.prompt, optional IR/debug outputs
├── cache/
│   ├── sources/            # locked dependency material
│   ├── cas/                # content-addressed build objects
│   └── actions.sqlite3     # rebuildable action index
├── metadata/
│   ├── layout.json         # private layout schema
│   ├── publications/       # publication + recovery records
│   └── catalog/            # compiler/build catalog
└── work/                   # disposable staging`}</code></pre><p class="callout">{locale === "zh-CN" ? "xmlsquish clean 删除整个配置的 target-dir；下次构建从源码、清单和锁文件重建。离线构建只有在 cache/sources 仍有所需依赖时才能成功。" : "xmlsquish clean removes the complete configured target-dir; the next build reconstructs it from sources, the manifest, and lockfile. An offline build succeeds only while cache/sources still contains every required dependency."}</p></section>
          <section><h2 id="artifacts">{locale === "zh-CN" ? "产物各自承担什么" : "What each artifact is for"}</h2><p>{m.notes.build}</p><div class="term-table"><div><code>.prompt</code><p>{locale === "zh-CN" ? "最终可消费产品。" : "The final consumable product."}</p></div><div><code>.xsir</code><p>{locale === "zh-CN" ? "规范二进制中间表示。" : "Canonical binary intermediate representation."}</p></div><div><code>.psdbg</code><p>{locale === "zh-CN" ? "溯源与调试映射。" : "Provenance and debug mapping."}</p></div></div></section>
          <section><h2 id="validation">{locale === "zh-CN" ? "为什么不只有 XSD" : "Why XSD is not enough"}</h2><p>{locale === "zh-CN" ? "导入闭包、QName 符号、调用契约、递归预算与发布事务都是跨文件规则，由管理器统一验证。" : "Import closure, QName symbols, call contracts, recursion budgets, and publication transactions are cross-file rules validated by the manager."}</p></section>
        </>}

        {chapter === "reference" && <section class="reference-section"><namespace-explorer>
          <div class="search-row" data-search-ui hidden><label for="directive-search">{m.filter}</label><input id="directive-search" type="search" autocomplete="off" placeholder={m.searchPlaceholder} data-search /><output data-count aria-live="polite"></output></div>
          <div class="directive-list">{directives.map((directive) => {
            const copy = m.directives[directive.name];
            const searchText = `${directive.name} ${directive.attributes.map(({ name }) => name).join(" ")} ${copy.summary} ${copy.detail} ${copy.context} ${copy.children} ${copy.constraints.join(" ")}`;
            return <article id={directive.name} data-directive data-search-text={searchText}>
              <header><a href={`#${directive.name}`} aria-label={`xs:${directive.name}`}><span aria-hidden="true">#</span></a><h2><code>xs:{directive.name}</code></h2><span>{m.groups[directive.group]}</span></header>
              <p class="directive-summary"><strong>{copy.summary}</strong> {copy.detail}</p>
              <div class="contract-grid"><section><h3>{m.referenceLabels.context}</h3><p>{copy.context}</p></section><section><h3>{m.referenceLabels.children}</h3><p>{copy.children}</p></section></div>
              <section class="attribute-contract"><h3>{m.referenceLabels.attributes}</h3>{directive.attributes.length === 0 ? <p>—</p> : <dl>{directive.attributes.map((attribute) => <><dt><code>{attribute.name}</code><span>{m.referenceLabels[attribute.requirement]}{"default" in attribute ? ` · ${m.referenceLabels.default}: ${attribute.default}` : ""}</span></dt><dd>{copy.attributes[attribute.name]}</dd></>)}</dl>}</section>
              <section><h3>{m.referenceLabels.syntax}</h3><pre><code>{directive.syntax}</code></pre></section>
              <section class="constraints"><h3>{m.referenceLabels.constraints}</h3><ul>{copy.constraints.map((constraint) => <li>{constraint}</li>)}</ul></section>
              <a class="related-link" href={manualPath(locale, directive.relatedChapter)}>{m.referenceLabels.related}: {m.chapters[directive.relatedChapter].nav} <span aria-hidden="true">→</span></a>
            </article>;
          })}</div><p class="empty-state" data-empty hidden>{m.empty}</p>
        </namespace-explorer></section>}

        {chapter === "limits-and-invariants" && <>
          <section><h2 id="budgets">{locale === "zh-CN" ? "资源预算" : "Resource budgets"}</h2><p>{m.notes.limits}</p><ul><li>{locale === "zh-CN" ? "展开深度与总步数" : "expansion depth and total steps"}</li><li>{locale === "zh-CN" ? "生成节点数与输出字节数" : "generated nodes and output bytes"}</li><li>{locale === "zh-CN" ? "正则输入与捕获工作量" : "regular-expression input and capture work"}</li></ul></section>
          <section><h2 id="invariants">{locale === "zh-CN" ? "语言不变量" : "Language invariants"}</h2><div class="invariant-list"><p>{m.notes.exactUri}</p><p>{m.notes.imports}</p><p>{m.notes.evaluation}</p><p>{m.notes.values}</p></div></section>
          <section id="resources"><h2>{m.resourcesTitle}</h2><p>{m.notes.version}</p><div class="resource-list">{dslResources.map((resource) => <a href={resource.href} rel={"rel" in resource ? resource.rel : undefined}><span>{resource.kind}</span><strong>{m.resources[resource.key].title}</strong><p>{m.resources[resource.key].body}</p><b aria-hidden="true">↗</b></a>)}</div></section>
        </>}
</ManualLayout>

<script is:inline>
  /** Enhance URI copying while preserving a selectable static value. / 增强 URI 复制，同时保留可选择的静态值。 */
  class NamespaceIdentity extends HTMLElement { connectedCallback() { const button=this.querySelector("[data-copy]");const value=this.querySelector("[data-namespace-uri]");const status=this.querySelector("[data-copy-status]");if(!(button instanceof HTMLButtonElement)||!value||!status||!navigator.clipboard)return;button.hidden=false;button.addEventListener("click",async()=>{try{await navigator.clipboard.writeText(value.textContent||"");status.textContent=button.dataset.copied||""}catch{const selection=window.getSelection();const range=document.createRange();range.selectNodeContents(value);selection?.removeAllRanges();selection?.addRange(range);status.textContent=button.dataset.denied||""}})}}
  /** Filter the complete server-rendered reference. / 筛选服务端完整渲染的参考表。 */
  class NamespaceExplorer extends HTMLElement {
    connectedCallback() {
      const ui = this.querySelector("[data-search-ui]");
      const input = this.querySelector("[data-search]");
      const count = this.querySelector("[data-count]");
      const empty = this.querySelector("[data-empty]");
      const cards = [...this.querySelectorAll("[data-directive]")];
      const outlineLinks = [...document.querySelectorAll('.manual-toc a[href^="#"], .mobile-toc a[href^="#"]')];
      if (!(ui instanceof HTMLElement) || !(input instanceof HTMLInputElement) || !(count instanceof HTMLOutputElement)) return;
      ui.hidden = false;

      /** Keep the article and both responsive outlines as one filtered view.
       * 让文章与两套响应式页内目录共享同一个筛选视图。
       */
      const update = () => {
        const query = input.value.trim().toLocaleLowerCase();
        const visibleIds = new Set();
        cards.forEach((card) => {
          const match = !query || (card.getAttribute("data-search-text") || "").toLocaleLowerCase().includes(query);
          card.toggleAttribute("hidden", !match);
          if (match && card.id) visibleIds.add(card.id);
        });
        outlineLinks.forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;
          link.toggleAttribute("hidden", !visibleIds.has(decodeURIComponent(link.hash.slice(1))));
        });
        count.textContent = `${visibleIds.size} / ${cards.length}`;
        empty?.toggleAttribute("hidden", visibleIds.size !== 0);
      };
      input.addEventListener("input", update);
      input.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && input.value) {
          input.value = "";
          update();
        }
      });
      update();
    }
  }
  if(!customElements.get("namespace-identity"))customElements.define("namespace-identity",NamespaceIdentity);if(!customElements.get("namespace-explorer"))customElements.define("namespace-explorer",NamespaceExplorer);
</script>

<style is:global>
  [hidden]{display:none!important}.section-kicker{margin:0;color:var(--moe-accent-strong);font:800 .68rem var(--moe-font-family-mono,monospace);letter-spacing:.11em;text-transform:uppercase}.uri-panel{display:grid;gap:.65rem;min-width:0;padding:1.15rem;border:1px solid color-mix(in srgb,var(--moe-accent) 35%,var(--xs-line));border-radius:.75rem;background:var(--moe-background)}.uri-panel>span:not(.copy-status){font-size:.72rem;color:var(--moe-text-soft)}.uri-panel .status{color:var(--moe-accent-strong)!important;font:800 .65rem var(--moe-font-family-mono,monospace);text-transform:uppercase}.uri-panel code{padding:.75rem;overflow-wrap:anywhere;border-radius:.45rem;color:var(--xs-code-text);background:var(--xs-code);font-size:.72rem;user-select:all}.uri-panel button{justify-self:start;min-height:2.4rem;padding:.48rem .72rem;border:1px solid var(--moe-accent);border-radius:.45rem;color:var(--moe-accent-strong);background:transparent;font-weight:800;cursor:pointer}.uri-panel button:hover{background:var(--moe-accent-wash)}.copy-status{min-height:1em;color:var(--moe-accent-strong);font-size:.7rem}.manual-article{min-width:0}.manual-article section{margin-bottom:clamp(3rem,7vw,5.5rem)}.manual-article :is(h2,h3)[id]{scroll-margin-top:5.5rem}.manual-article h2{margin:.55rem 0 1rem;font-size:clamp(1.75rem,3vw,2.45rem);line-height:1.12;letter-spacing:-.04em}.manual-article p,.manual-article li{line-height:1.75}.manual-article>section>p{color:var(--moe-text-soft)}.manual-article pre{max-width:100%;margin:1.3rem 0;padding:1.2rem;overflow-x:auto;border:1px solid #fff2;border-radius:.75rem;color:var(--xs-code-text);background:var(--xs-code);font-size:.78rem;line-height:1.7}.overview-start{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:2rem}.overview-start pre{margin:0}.callout{padding:1rem;border-left:3px solid var(--moe-accent);background:var(--moe-accent-wash)}.chapter-cta{display:inline-flex;gap:.5rem;padding:.65rem .85rem;border:1px solid var(--moe-accen