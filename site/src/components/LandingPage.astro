---
import { Code } from "astro:components";
import ThemeControl from "./ThemeControl";
import BuildExplorer from "./BuildExplorer.astro";
import type { Locale } from "../i18n/messages";
import { messages } from "../i18n/messages";
import demo from "../data/build-demo.json";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = messages[locale];
const languageHref = locale === "zh-CN" ? "/en/" : "/";
const repo = "https://github.com/kleedaisuki/prompt-squish";
const metrics = demo.scenarios.parent.metrics;
const [diagnosticHeadline, ...diagnosticLines] = demo.diagnostic.split("\n");
const diagnosticRest = "\n" + diagnosticLines.join("\n");
const heroCode =
  '<xs:mount src="persona.xml">\n  <xs:arg name="audience" value="researchers"/>\n</xs:mount>\n<xs:call ref="demo:task"/>';
const commands = [
  {
    title: m.cli.install,
    code: "cargo install --path . --locked",
  },
  { title: m.cli.inspect, code: "xmlsquish -I examples/site-demo/agent.xml" },
  { title: m.cli.optimize, code: "xmlsquish -O examples/site-demo/agent.xml" },
  {
    title: m.cli.color,
    code: "xmlsquish --color never examples/site-demo/agent.xml",
  },
];
const stages = [
  { label: m.stats.source, value: metrics.sourceTokens, unit: "tokens", file: "agent.xml" },
  { label: m.stats.ir, value: metrics.irBytes, unit: "UTF-8 bytes", file: "agent.i.xml" },
  { label: m.stats.final, value: metrics.finalTokens, unit: "tokens", file: "agent.o.xml" },
];
---

<header class="site-header">
  <div class="page-width header-inner">
    <a class="brand" href={locale === "zh-CN" ? "/" : "/en/"} aria-label="xmlsquish">
      <img src="/favicon.svg" alt="" width="38" height="38" />
      <span><strong>xmlsquish</strong><small>source. compose. build.</small></span>
    </a>
    <nav class="header-nav" aria-label={m.nav.label}>
      <a href="#build">{m.nav.build}</a>
      <a href="#model">{m.nav.model}</a>
      <a href="#cli">{m.nav.cli}</a>
    </nav>
    <div class="header-actions">
      <a class="language-link" href={languageHref} lang={locale === "zh-CN" ? "en" : "zh-CN"} hreflang={locale === "zh-CN" ? "en" : "zh-CN"}>{m.nav.language}</a>
      <ThemeControl client:load labels={m.theme} />
      <a class="github-link" href={repo} aria-label="GitHub"><svg viewBox="0 0 24 24" width="21" height="21" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.4 11.4 0 0 0-3.6 22.2c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.4-1.3-5.4-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.4 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.4 11.4 0 0 0 12 .8Z"/></svg></a>
    </div>
  </div>
</header>

<main id="main">
  <section class="hero page-width" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="spark" aria-hidden="true">✦</span> {m.hero.badge}</p>
      <h1 id="hero-title">{m.hero.title}<em>{m.hero.accent}</em></h1>
      <p class="hero-lead">{m.hero.lead}</p>
      <div class="hero-actions">
        <a class="action primary" href="#build">{m.hero.primary}<span aria-hidden="true">↗</span></a>
        <a class="action secondary" href="#cli">{m.hero.secondary}<span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero-footnote">{m.hero.footnote}</p>
    </div>
    <figure class="build-graph" aria-label={m.hero.caption}>
      <div class="graph-toolbar"><span class="graph-dot" aria-hidden="true"></span><code>build / agent.xml</code><span class="graph-status">XML → XML</span></div>
      <div class="graph-sources">
        <div class="graph-label"><span>01</span>{m.hero.source}</div>
        <div class="entry-file"><span class="file-symbol" aria-hidden="true">&lt;/&gt;</span><strong>agent.xml</strong><code>xs:arg</code></div>
        <div class="file-branches">
          <div><span aria-hidden="true">├─</span><code>persona.xml</code><small>mount + arg</small></div>
          <div><span aria-hidden="true">└─</span><code>tasks.xml</code><small>import + call</small></div>
        </div>
      </div>
      <div class="graph-compiler">
        <div class="graph-label"><span>02</span>{m.hero.compile}</div>
        <Code code={heroCode} lang="xml" theme="rose-pine" />
      </div>
      <div class="graph-artifacts">
        <div class="graph-label"><span>03</span>{m.hero.artifact}</div>
        <div class="artifact-path"><code>agent.i.xml</code><span aria-hidden="true">→</span><code class="final-artifact">agent.o.xml <span aria-hidden="true">✓</span></code></div>
      </div>
      <figcaption>{m.hero.caption}</figcaption>
    </figure>
  </section>

  <section id="how" class="journey-band" aria-label={m.journey.note}>
    <ol class="journey page-width">
      {m.journey.steps.map((step) => <li><span class="eyebrow">{step.label}</span><h2>{step.title}</h2><p>{step.body}</p></li>)}
    </ol>
  </section>

  <section id="build" class="section page-width" aria-labelledby="build-title">
    <div id="principles-title" class="section-heading"><p class="eyebrow">{m.build.eyebrow}</p><h2 id="build-title">{m.build.title}</h2><p>{m.build.intro}</p></div>
    <BuildExplorer locale={locale} />
    <a class="text-link example-link" href={`${repo}/tree/main/examples/site-demo`}>{m.footer.source}<span aria-hidden="true"> ↗</span></a>
  </section>

  <section id="model" class="section model-section" aria-labelledby="model-title">
    <div class="page-width">
      <div class="section-heading"><p class="eyebrow">{m.model.eyebrow}</p><h2 id="model-title">{m.model.title}</h2><p>{m.model.intro}</p></div>
      <div class="inheritance-map">
        <div class="frame-node parent-frame"><div class="frame-head"><span class="tiny-square" aria-hidden="true"></span>{m.model.parent}</div><dl><div><dt>xs:arg value</dt><dd>researchers</dd></div><div><dt>file.name</dt><dd>agent.xml</dd></div></dl></div>
        <div class="inheritance-edge"><code>xs:arg</code><span aria-hidden="true">⟶</span><small>{m.model.inherited}</small></div>
        <div class="frame-node child-frame"><div class="frame-head"><span class="tiny-square" aria-hidden="true"></span>{m.model.child}</div><dl><div><dt>arg.audience</dt><dd><strong>researchers</strong></dd></div><div><dt>file.name</dt><dd>persona.xml <span aria-label={m.model.physical}>⌁</span></dd></div></dl></div>
      </div>
      <p class="inheritance-note"><span aria-hidden="true">↳</span>{m.model.note}</p>
      <div class="frame-grid">
        {m.model.fields.map((field) => <article class="frame-field"><code class="namespace">{field.name}</code><h3>{field.title}</h3><p>{field.body}</p><code class="field-sample">{field.sample}</code></article>)}
      </div>
    </div>
  </section>

  <section class="section page-width" aria-labelledby="capabilities-title">
    <div class="section-heading"><p class="eyebrow">{m.capabilities.eyebrow}</p><h2 id="capabilities-title">{m.capabilities.title}</h2></div>
    <div class="capabilities">
      {m.capabilities.items.map((item, index) => <article class="capability"><div class="capability-copy"><span class="capability-index">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></div><div class="capability-code"><Code code={item.code} lang="xml" theme="rose-pine" /></div></article>)}
    </div>
  </section>

  <section id="cli" class="section cli-section" aria-labelledby="cli-title">
    <div class="page-width">
      <div class="cli-layout">
        <div class="cli-copy"><p class="eyebrow">{m.cli.eyebrow}</p><h2 id="cli-title">{m.cli.title}</h2><p>{m.cli.intro}</p><p class="small-note">{m.cli.note}</p><a class="text-link" href={`${repo}#安装与构建`}>{m.hero.secondary} ↗</a></div>
        <div class="command-terminal"><div class="terminal-title"><span class="graph-dot" aria-hidden="true"></span><code>terminal / xmlsquish</code></div>{commands.map((command) => <div class="command"><p># {command.title}</p><pre><code><span aria-hidden="true">$ </span>{command.code}</code></pre></div>)}</div>
      </div>
      <div class="diagnostic-layout"><div><h3>{m.cli.diagnosticTitle}</h3><p>{m.cli.diagnosticBody}</p></div><pre class="diagnostic"><code><span>{diagnosticHeadline}</span>{diagnosticRest}</code></pre></div>
    </div>
  </section>

  <section id="stats" class="section page-width" aria-labelledby="stats-title">
    <div class="section-heading"><p class="eyebrow">{m.stats.eyebrow}</p><h2 id="stats-title">{m.stats.title}</h2><p>{m.stats.intro}</p></div>
    <div class="metrics-stages">{stages.map((stage, index) => <div class:list={["metric-stage", index === 2 && "metric-final"]}><span>{stage.label}</span><strong>{stage.value}<small>{stage.unit}</small></strong><code>{stage.file}</code></div>)}</div>
    <div class="metrics-details"><div><strong>{metrics.dependencyLoads}<small> / {metrics.uniqueDeps} {m.stats.files}</small></strong><span>{m.stats.dependencies}</span></div><div><strong>{metrics.finalBytes}<small> UTF-8 bytes</small></strong><span>agent.o.xml</span></div></div>
    <p class="metrics-note">{m.stats.note}</p>
  </section>

  <section class="boundaries page-width" aria-labelledby="boundaries-title">
    <div><p class="eyebrow">THE FINE PRINT, UP FRONT.</p><h2 id="boundaries-title">{m.limits.title}</h2><p>{m.limits.body}</p><a class="text-link" href={`${repo}/blob/main/docs/dsl.md`}>{m.limits.docs} ↗</a></div>
    <details class="engine-details"><summary>{m.limits.details}<span aria-hidden="true">+</span></summary><div><h3 id="fsm-title">{m.limits.engine}</h3><p>{m.limits.engineBody}</p><code>XML → compile → expand → IR → lower → squish → output</code><a class="text-link" href={`${repo}/blob/main/docs/dsl.md`}>DSL specification ↗</a></div></details>
  </section>

  <section class="closing page-width"><img src="/favicon.svg" alt="" width="58" height="58" loading="lazy"/><h2>{m.footer.tagline}</h2><a class="action primary" href={repo}>{m.footer.source}<span aria-hidden="true">↗</span></a></section>
</main>
<footer class="site-footer"><div class="page-width footer-inner"><span><strong>xmlsquish</strong> · source. compose. build.</span><div><a href="https://style.moesegfault.dev/">{m.footer.style} ✦</a><a href="/LICENSE.txt">{m.footer.license}</a><a href="/THIRD_PARTY_NOTICES.txt">{m.footer.notices}</a></div></div></footer>

<style>
  .page-width {
    width: min(100% - 3rem, 76rem);
    margin-inline: auto;
  }
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--xs-line);
    background: color-mix(
      in srgb,
      var(--moe-background, #fff9f0) 92%,
      transparent
    );
    backdrop-filter: blur(16px);
  }
  .header-inner {
    min-height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--moe-heading);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand span {
    display: grid;
    gap: 0.1rem;
  }
  .brand strong {
    font-size: 1.25rem;
    letter-spacing: -0.04em;
  }
  .brand small {
    font: 0.62rem var(--moe-font-family-mono, monospace);
    color: var(--moe-text-soft);
  }
  .header-nav,
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.65rem;
  }
  .header-actions {
    gap: 1rem;
  }
  .header-nav a,
  .language-link {
    color: var(--moe-text-soft);
    text-decoration: none;
    font-size: 0.83rem;
    font-weight: 650;
  }
  .header-nav a:hover,
  .language-link:hover {
    color: var(--moe-accent-strong);
  }
  .github-link {
    color: var(--moe-heading);
    display: flex;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-block: clamp(4.8rem, 8vw, 8rem) 6rem;
  }
  .eyebrow {
    font: 700 0.69rem var(--moe-font-family-mono, monospace);
    letter-spacing: 0.12em;
    color: var(--moe-accent-strong);
    margin: 0 0 1.2rem;
  }
  .spark {
    margin-right: 0.35rem;
    font-size: 1.3rem;
  }
  .hero h1 {
    margin: 1.5rem 0;
    font-size: clamp(3rem, 5.4vw, 5.05rem);
    letter-spacing: -0.065em;
    line-height: 1.1;
    font-weight: 800;
  }
  .hero h1 em {
    display: block;
    color: var(--moe-accent-strong);
    font-style: normal;
  }
  .hero-lead {
    color: var(--moe-text-soft);
    font-size: 1.06rem;
    line-height: 1.85;
    max-width: 34rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.9rem;
  }
  .action {
    display: inline-flex;
    gap: 1.35rem;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.15rem;
    border-radius: 0.6rem;
    font-size: 0.9rem;
    font-weight: 750;
    text-decoration: none;
    transition: transform 0.15s;
  }
  .action:hover {
    transform: translateY(-2px);
  }
  .action.primary {
    background: var(--moe-accent-strong, #b44727);
    color: var(--moe-on-accent, #fffaf3);
    box-shadow: 0 5px 15px var(--xs-glow);
  }
  .action.secondary {
    color: var(--moe-heading);
    border: 1px solid var(--moe-border);
    background: var(--moe-surface-strong);
  }
  .hero-footnote {
    margin: 1.25rem 0 0;
    font-size: 0.71rem;
    color: var(--moe-text-soft);
  }
  .build-graph {
    position: relative;
    margin: 0;
    border: 1px solid var(--moe-border);
    border-radius: 1rem;
    background: var(--moe-surface-strong);
    box-shadow:
      0 18px 60px color-mix(in srgb, var(--moe-accent) 10%, transparent),
      0 2px 4px #33130008;
  }
  .build-graph:before {
    content: "";
    position: absolute;
    inset: -1rem 1.5rem 1.5rem -1rem;
    border: 1px solid var(--xs-line);
    border-radius: 1rem;
    z-index: -1;
    transform: rotate(-3deg);
  }
  .graph-toolbar,
  .terminal-title {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    padding: 0.9rem 1.3rem;
    font-size: 0.73rem;
    border-bottom: 1px solid var(--xs-line);
  }
  .graph-dot {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 50%;
    background: var(--moe-accent);
  }
  .graph-status {
    margin-left: auto;
    font: 0.63rem var(--moe-font-family-mono, monospace);
    color: var(--moe-text-soft);
  }
  .graph-sources {
    padding: 1.15rem 1.4rem;
  }
  .graph-label {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font: 650 0.7rem var(--moe-font-family-mono, monospace);
    color: var(--moe-text-soft);
    margin-bottom: 0.8rem;
  }
  .graph-label > span {
    color: var(--moe-accent-strong);
    font-size: 0.6rem;
  }
  .entry-file {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid var(--xs-line);
  }
  .entry-file strong {
    font: 700 0.86rem var(--moe-font-family-mono, monospace);
  }
  .entry-file > code {
    margin-left: auto;
    font-size: 0.61rem;
    color: var(--moe-accent-strong);
  }
  .file-symbol {
    color: var(--moe-accent-strong);
    font: 0.8rem var(--moe-font-family-mono, monospace);
  }
  .file-branches {
    margin: 0.55rem 0 0 0.8rem;
    display: grid;
    gap: 0.4rem;
  }
  .file-branches > div {
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }
  .file-branches > div > span {
    color: var(--moe-border);
  }
  .file-branches code {
    font-size: 0.8rem;
  }
  .file-branches small {
    margin-left: auto;
    color: var(--moe-text-soft);
    font: 0.61rem var(--moe-font-family-mono, monospace);
  }
  .graph-compiler {
    padding: 1.05rem 1.4rem 1.25rem;
    background: #241d25;
  }
  .graph-compiler .graph-label {
    color: #b8a6ae;
  }
  .graph-compiler .graph-label > span {
    color: #eda98b;
  }
  .graph-compiler :global(pre) {
    padding: 0;
    margin: 0;
    background: transparent !important;
    font-size: 0.78rem;
    line-height: 1.8;
    overflow-x: auto;
  }
  .graph-artifacts {
    padding: 1rem 1.4rem;
  }
  .artifact-path {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .artifact-path > code {
    font-size: 0.79rem;
  }
  .artifact-path > span {
    color: var(--moe-text-soft);
  }
  .final-artifact {
    padding: 0.5rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--moe-accent) 38%, transparent);
    background: var(--moe-accent-wash);
    border-radius: 0.4rem;
  }
  .final-artifact span {
    color: var(--moe-accent-strong);
    margin-left: 0.45rem;
  }
  .build-graph figcaption {
    border-top: 1px solid var(--xs-line);
    padding: 0.8rem 1.4rem;
    color: var(--moe-text-soft);
    font-size: 0.67rem;
    line-height: 1.6;
  }
  .journey-band {
    border-block: 1px solid var(--xs-line);
    background: color-mix(in srgb, var(--moe-surface-muted) 48%, transparent);
  }
  .journey {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-block: 2.2rem;
    padding-left: 0;
    list-style: none;
    gap: 2.3rem;
  }
  .journey li {
    padding-right: 2rem;
    border-right: 1px solid var(--xs-line);
  }
  .journey li:last-child {
    border: 0;
    padding: 0;
  }
  .journey .eyebrow {
    font-size: 0.6rem;
  }
  .journey h2 {
    margin: 0.65rem 0;
    font-size: 1.2rem;
    letter-spacing: -0.025em;
  }
  .journey p {
    font-size: 0.85rem;
    color: var(--moe-text-soft);
    margin: 0;
    line-height: 1.7;
  }
  .section {
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
    scroll-margin-top: 4rem;
  }
  .section-heading {
    max-width: 47rem;
    margin-bottom: 2.6rem;
  }
  .section-heading h2,
  .cli-copy h2 {
    font-size: clamp(2rem, 3.5vw, 3.1rem);
    line-height: 1.22;
    letter-spacing: -0.045em;
    margin: 0.7rem 0 1.2rem;
  }
  .section-heading > p:last-child,
  .cli-copy > p:not(.eyebrow) {
    color: var(--moe-text-soft);
    line-height: 1.85;
    font-size: 0.98rem;
  }
  .text-link {
    color: var(--moe-accent-strong);
    font-size: 0.86rem;
    font-weight: 700;
    text-underline-offset: 0.25em;
  }
  .example-link {
    display: inline-block;
    margin-top: 1.3rem;
  }
  .model-section {
    background: color-mix(in srgb, var(--moe-surface-muted) 50%, transparent);
    border-block: 1px solid var(--xs-line);
  }
  .inheritance-map {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12rem minmax(0, 1fr);
    align-items: center;
  }
  .frame-node {
    background: var(--moe-surface-strong);
    border: 1px solid var(--moe-border);
    border-radius: 0.7rem;
    overflow: hidden;
  }
  .frame-head {
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--xs-line);
    font: 0.76rem var(--moe-font-family-mono, monospace);
  }
  .tiny-square {
    width: 0.4rem;
    height: 0.4rem;
    background: var(--moe-accent);
  }
  .frame-node dl {
    margin: 0;
    padding: 1.05rem 1rem;
    display: grid;
    gap: 0.9rem;
  }
  .frame-node dl > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .frame-node dt {
    font: 0.7rem var(--moe-font-family-mono, monospace);
    color: var(--moe-text-soft);
  }
  .frame-node dd {
    margin: 0;
    display: flex;
    gap: 0.6rem;
    font: 0.76rem var(--moe-font-family-mono, monospace);
  }
  .frame-node del {
    color: var(--moe-text-soft);
    opacity: 0.75;
  }
  .frame-node dd strong {
    color: var(--moe-accent-strong);
    font-weight: 700;
  }
  .child-frame {
    border-color: color-mix(in srgb, var(--moe-accent) 65%, var(--moe-border));
  }
  .inheritance-edge {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
