---
import ReleaseLayout from "../layouts/ReleaseLayout.astro";
import type { Locale } from "../i18n/messages";
import { releaseMessages } from "../i18n/releases";
import { assetUrl, releases, repository, type ProductRelease } from "../data/releases";

/** Immutable release detail input. / 不可变发布详情输入。 */
interface Props { locale: Locale; release: ProductRelease; }
const { locale, release } = Astro.props;
const m = releaseMessages[locale];
const copy = m.versions[release.version];
/** Resolve reciprocal localized detail routes without changing release identity.
 * 解析互为对应的本地化详情路径，同时保持版本身份不变。 */
const releasePath = (language: Locale, version: string) => language === "en" ? `/en/releases/${version}/` : `/releases/${version}/`;
const indexPath = locale === "en" ? "/en/releases/" : "/releases/";
const canonicalPath = releasePath(locale, release.version);
const alternatePaths = { "zh-CN": releasePath("zh-CN", release.version), en: releasePath("en", release.version) };
const catalogIndex = releases.findIndex((item) => item.version === release.version);
const newer = catalogIndex > 0 ? releases[catalogIndex - 1] : undefined;
const older = catalogIndex < releases.length - 1 ? releases[catalogIndex + 1] : undefined;
const nativeAssets = release.acquisition.kind === "native"
  ? release.acquisition.platforms.flatMap((platform) => platform.targets.map((target) => assetUrl(release, platform, target)))
  : [];
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${new URL(canonicalPath, Astro.site).href}#xmlsquish-${release.tag}`,
  name: "xmlsquish",
  headline: copy.title,
  description: copy.description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Windows, Linux, macOS",
  softwareVersion: release.version,
  datePublished: release.date,
  isAccessibleForFree: true,
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  sameAs: repository,
  downloadUrl: nativeAssets.length ? nativeAssets : undefined,
  releaseNotes: new URL(canonicalPath, Astro.site).href,
  inLanguage: locale,
}).replaceAll("<", "\\u003c");
---

<ReleaseLayout
  locale={locale}
  title={`xmlsquish ${release.version} — ${copy.title}`}
  description={copy.description}
  canonicalPath={canonicalPath}
  alternatePaths={alternatePaths}
  languageSwitchHref={alternatePaths[locale === "en" ? "zh-CN" : "en"]}
  releaseMetadataPath={release.metadataPath ?? null}
  releaseVersion={release.version}
  eyebrow={`${release.tag} · ${release.status === "current" ? m.index.current : m.index.historical}`}
  heading={copy.title}
  dek={copy.summary}
  backHref={indexPath}
  backLabel={m.detail.back}
  outline={[...copy.changes.map((group) => ({ href: `#${group.id}` as `#${string}`, label: group.title })), { href: "#acquisition", label: m.detail.acquisition }, { href: "#compatibility", label: m.detail.compatibility }]}
  outlineLabel={m.detail.onThisPage}
  factsLabel={locale === "zh-CN" ? "版本事实" : "Release facts"}
  previous={older ? { href: releasePath(locale, older.version), label: `v${older.version}` } : undefined}
  next={newer ? { href: releasePath(locale, newer.version), label: `v${newer.version}` } : undefined}
  previousLabel={m.detail.previous}
  nextLabel={m.detail.next}
  allHref={indexPath}
  allLabel={m.detail.allReleases}
>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={structuredData}></script></Fragment>
  <Fragment slot="factline"><time datetime={release.date}>{copy.date}</time>{release.protocol && <span>· {m.detail.protocol} {release.protocol}</span>}<span>· {release.acquisition.kind === "native" ? m.index.acquisitionNative : m.index.acquisitionSource}</span></Fragment>
  <Fragment slot="actions"><a href="#acquisition">{m.detail.acquisition}<span aria-hidden="true">↓</span></a><a href={release.githubRelease}>{m.detail.github}<span aria-hidden="true">↗</span></a>{release.metadataPath && <a href={release.metadataPath}>{m.detail.metadata}<span aria-hidden="true">↗</span></a>}</Fragment>
  <Fragment slot="facts"><dl><div><dt>{m.detail.date}</dt><dd><time datetime={release.date}>{copy.date}</time></dd></div>{release.protocol && <div><dt>{m.detail.protocol}</dt><dd><code>{release.protocol}</code></dd></div>}<div><dt>{m.detail.distribution}</dt><dd>{release.acquisition.kind === "native" ? m.index.acquisitionNative : m.index.acquisitionSource}</dd></div></dl></Fragment>
  <Fragment slot="resources"><a href={release.githubRelease}>{m.detail.github}<span aria-hidden="true">↗</span></a>{release.metadataPath && <a href={release.metadataPath}>{m.detail.metadata}<span aria-hidden="true">↗</span></a>}</Fragment>

        <section id="changes" aria-labelledby="changes-title">
          <p class="section-label">01</p><h2 id="changes-title">{m.detail.changes}</h2>
          {copy.changes.map((group) => <section class="change-group" id={group.id}><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></section>)}
        </section>

        <section id="acquisition" aria-labelledby="acquisition-title">
          <p class="section-label">02</p><h2 id="acquisition-title">{m.detail.acquisition}</h2>
          {release.acquisition.kind === "native" ? <>
            <h3>{m.detail.nativeTitle}</h3><p>{m.detail.nativeBody}</p>
            <div class="download-table">
              {release.acquisition.platforms.map((platform) => <section><div><h4>{platform.name}</h4><span>{platform.note[locale]}</span></div><ul>{platform.targets.map((target) => <li><a href={assetUrl(release, platform, target)} download><strong>{target.label}</strong><code>{target.triple}</code><span aria-hidden="true">↓</span></a></li>)}</ul></section>)}
            </div>
            <a class="resource-button" href={release.acquisition.checksums}>{m.detail.checksums}<span aria-hidden="true">↗</span></a>
            <p class="caution">{m.detail.unsignedNote}</p>
          </> : <><h3>{m.detail.sourceTitle}</h3><p>{m.detail.sourceBody}</p></>}
          <h3>{m.detail.sourceInstall}</h3><pre><code>{release.acquisition.sourceInstall}</code></pre>
        </section>

        <section id="compatibility" aria-labelledby="compatibility-title">
          <p class="section-label">03</p><h2 id="compatibility-title">{m.detail.compatibility}</h2>
          <ul class="compatibility-list">{copy.compatibility.map((item) => <li>{item}</li>)}</ul>
        </section>

</ReleaseLayout>

<style is:global>
  .release-kicker{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;margin-top:2rem}.release-kicker code{color:var(--moe-accent-strong);font-size:.8rem;font-weight:850}.release-kicker span{padding:.22rem .5rem;border:1px solid var(--xs-line);border-radius:999px;color:var(--moe-text-soft);font:700 .65rem var(--moe-font-family-mono,monospace)}
  h1{max-width:58rem;margin:.8rem 0 1rem;font-size:clamp(2.35rem,5vw,4.3rem);line-height:1.03;letter-spacing:-.052em}.summary{max-width:54rem;margin:0;color:var(--moe-text-soft);font-size:clamp(1rem,2vw,1.15rem);line-height:1.75}
  .release-article>section{padding-bottom:3.5rem;scroll-margin-top:6rem}.release-article>section+section{padding-top:3.5rem;border-top:1px solid var(--xs-line)}.section-label{margin:0;color:var(--moe-accent-strong);font:800 .65rem var(--moe-font-family-mono,monospace)}h2{margin:.55rem 0 1.8rem;font-size:clamp(1.8rem,3.5vw,2.65rem);letter-spacing:-.035em}.change-group{padding:0 0 1.6rem 1.25rem;border-left:2px solid var(--xs-line);scroll-margin-top:6rem}.change-group:last-child{padding-bottom:0}.change-group h3,.release-article h3{margin:0 0 .75rem;font-size:1.15rem}.change-group ul,.compatibility-list{margin:0;padding-left:1.15rem}.change-group li,.compatibility-list li{padding:.3rem 0;color:var(--moe-text-soft);line-height:1.65}.release-article>section>p:not(.section-label),.caution{color:var(--moe-text-soft);line-height:1.7}
  .download-table{margin:1.4rem 0;overflow:hidden;border:1px solid var(--xs-line);border-radius:.65rem}.download-table>section{display:grid;grid-template-columns:9rem 1fr;gap:1rem;padding:1rem}.download-table>section+section{border-top:1px solid var(--xs-line)}.download-table h4{margin:0 0 .2rem}.download-table section>div>span{color:var(--moe-text-soft);font-size:.66rem}.download-table ul{display:grid;gap:.35rem;margin:0;padding:0;list-style:none}.download-table a{display:grid;grid-template-columns:4rem 1fr auto;align-items:center;gap:.6rem;padding:.5rem .6rem;border-radius:.35rem;color:var(--moe-heading);font-size:.72rem}.download-table a:hover{color:var(--moe-accent-strong);background:var(--moe-accent-wash)}.download-table a code{min-width:0;overflow-wrap:anywhere;color:var(--moe-text-soft);font-size:.65rem}.resource-button{display:inline-flex;align-items:center;gap:.6rem;padding:.55rem .75rem;border:1px solid var(--xs-line);border-radius:.4rem;color:var(--moe-heading);font-size:.75rem;font-weight:800}.resource-button:hover{border-color:var(--moe-accent);color:var(--moe-accent-strong);background:var(--moe-accent-wash)}.caution{padding:.85rem 1rem;border-left:3px solid var(--moe-accent);background:var(--moe-accent-wash);font-size:.8rem}.release-article pre{margin:1rem 0 0;padding:1rem;overflow-x:auto;border-radius:.55rem;color:var(--xs-code-text);background:var(--xs-code);font-size:.75rem}
  @media(max-width:760px){.download-table>section{grid-template-columns:1fr}}
  @media(max-width:480px){.download-table a{grid-template-columns:3.5rem 1fr auto}}
</style>
