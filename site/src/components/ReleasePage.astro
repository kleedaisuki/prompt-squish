---
import ProductShell from "../layouts/ProductShell.astro";
import { messages, type Locale } from "../i18n/messages";
import { paths } from "../i18n/routes";
import { assetUrl, latestRelease, repository } from "../data/releases";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const m = messages[locale].reference.release;
const release = latestRelease;
const assetUrls = release.platforms.flatMap((platform) => platform.targets.map((target) => assetUrl(platform, target)));
const releaseUrl = new URL(Astro.url.pathname, Astro.site).href;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${releaseUrl}#xmlsquish-${release.tag}`,
  name: "xmlsquish",
  description: m.description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Windows, Linux, macOS",
  softwareVersion: release.version,
  datePublished: release.date,
  isAccessibleForFree: true,
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  sameAs: repository,
  downloadUrl: assetUrls,
  releaseNotes: releaseUrl,
  inLanguage: locale,
  creativeWorkStatus: "Published",
}).replaceAll("<", "\\u003c");
const previousLinks: Record<string, string> = {
  "1.0.0": `${repository}/releases/tag/v1.0.0`,
  "0.3.0": `${repository}/releases/tag/v0.3.0`,
  "0.2.0": `${repository}/releases/tag/v0.2.0`,
};
---
<ProductShell locale={locale} page="releases" title={m.title} description={m.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </Fragment>
  <main id="main" class="release-page">
    <header class="release-hero product-width">
      <div class="hero-copy">
        <p class="eyebrow">{m.eyebrow} · <time datetime={release.date}>{m.date}</time></p>
        <div class="release-badges"><span>{release.tag}</span><span>{m.status}</span><span>protocol {release.protocol}</span></div>
        <h1>{m.heroTitle}<em>{m.heroAccent}</em></h1>
        <p class="lead">{m.heroBody}</p>
        <nav class="actions" aria-label={m.releaseActions}>
          <a class="button primary" href="#install">{m.installCta}<span aria-hidden="true">↓</span></a>
          <a class="button secondary" href={release.githubRelease}>{m.githubCta}<span aria-hidden="true">↗</span></a>
        </nav>
      </div>
      <aside class="impact-card" aria-labelledby="impact-title">
        <span class="impact-icon" aria-hidden="true">3.0</span>
        <div><p class="eyebrow" id="impact-title">{m.impactLabel}</p><p>{m.impact}</p></div>
      </aside>
    </header>

    <section id="install" class="release-section acquisition-band" aria-labelledby="acquisition-title">
      <div class="product-width">
        <div class="section-heading"><p class="eyebrow">{m.acquisitionEyebrow}</p><h2 id="acquisition-title">{m.acquisitionTitle}</h2><p>{m.acquisitionBody}</p></div>
        <div class="download-grid">
          {release.platforms.map((platform) => <article><p class="platform-kind">{platform.note[locale]}</p><h3>{platform.name}</h3><div class="download-actions">{platform.targets.map((target) => <a class="download-link" href={assetUrl(platform, target)} download><span>{target.label}</span><code>{target.triple}</code><b aria-hidden="true">↓</b></a>)}</div></article>)}
        </div>
        <div class="verification-grid">
          <article><p class="eyebrow">SHA-256</p><a class="resource-link" href={release.checksums}>{m.checksums}<span aria-hidden="true">↗</span></a><p>{m.binaryNote}</p></article>
          <article><p class="eyebrow">{m.sourceLabel}</p><pre><code>{release.sourceInstall}</code></pre><p>{m.sourceBody}</p></article>
        </div>
      </div>
    </section>

    <section class="release-section product-width" aria-labelledby="changes-title">
      <div class="section-heading"><p class="eyebrow">{m.changesEyebrow}</p><h2 id="changes-title">{m.changesTitle}</h2></div>
      <div class="highlight-grid">{m.highlights.map((item, index) => <article><span>0{index + 1} · {item.label}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
      <div class="change-groups">{m.changeGroups.map((group) => <article><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
    </section>

    <section class="release-section migration-band" aria-labelledby="migration-title">
      <div class="product-width migration-layout">
        <div><p class="eyebrow">{m.migrationEyebrow}</p><h2 id="migration-title">{m.migrationTitle}</h2><p class="lead">{m.migrationLead}</p></div>
        <ol>{m.migrationSteps.map((step, index) => <li><span>0{index + 1}</span><p>{step}</p></li>)}</ol>
      </div>
      <div class="product-width compatibility"><h3>{m.supportTitle}</h3><p>{m.supportBody}</p><a class="resource-link" href={paths[locale].namespace}>{messages[locale].reference.nav.namespace}<span aria-hidden="true">→</span></a></div>
    </section>

    <section class="release-section product-width" aria-labelledby="history-title">
      <div class="section-heading"><p class="eyebrow">{m.historyEyebrow}</p><h2 id="history-title">{m.historyTitle}</h2></div>
      <div class="history-list">{m.previous.map((item) => <article id={`v${item.version.replaceAll(".", "-")}`}><div><span class="version">v{item.version}</span><span class="status">{item.status}</span></div><time>{item.date}</time><p>{item.summary}</p><div class="history-actions"><a href={previousLinks[item.version]}>GitHub Release <span aria-hidden="true">↗</span></a>{item.version === "1.0.0" && <a href="/releases/1.0.0.json">{m.releaseMetadata} <span aria-hidden="true">↗</span></a>}</div></article>)}</div>
    </section>
  </main>
</ProductShell>

<style>
  .release-page{overflow:hidden}.eyebrow{margin:0;color:var(--moe-accent-strong);font:800 .7rem var(--moe-font-family-mono,monospace);letter-spacing:.11em;text-transform:uppercase}.release-hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(18rem,.72fr);align-items:center;gap:clamp(2rem,6vw,6rem);padding-block:clamp(4rem,8vw,7rem)}.release-badges{display:flex;flex-wrap:wrap;gap:.5rem;margin-block:1rem}.release-badges span,.status{padding:.25rem .55rem;border:1px solid var(--xs-line);border-radius:999px;background:var(--moe-surface);font:700 .68rem var(--moe-font-family-mono,monospace)}h1{margin:.9rem 0 1.4rem;font-size:clamp(3rem,6vw,5.6rem);line-height:.96;letter-spacing:-.065em}h1 em{display:block;color:var(--moe-accent-strong);font-style:normal}.lead{max-width:45rem;font-size:clamp(1.04rem,2vw,1.22rem);line-height:1.75}.actions,.download-actions,.history-actions{display:flex;flex-wrap:wrap;gap:.7rem}.actions{margin-top:1.6rem}.button,.resource-link{display:inline-flex;align-items:center;justify-content:center;gap:.8rem;min-height:2.8rem;padding:.65rem 1rem;border:1px solid var(--xs-line);border-radius:var(--moe-radius-sm,.5rem);color:var(--moe-heading);font-weight:780}.button.primary{color:var(--moe-on-accent);background:var(--moe-accent-strong);border-color:transparent}.button:hover,.resource-link:hover{background:var(--moe-accent-wash);border-color:var(--moe-accent);transform:translateY(-1px)}.button.primary:hover{color:var(--moe-on-accent);background:color-mix(in srgb,var(--moe-accent-strong) 88%,black);border-color:transparent}.impact-card{display:grid;grid-template-columns:auto 1fr;gap:1.2rem;margin:0;padding:1.4rem;background:var(--xs-glow);border:1px solid color-mix(in srgb,var(--moe-accent) 35%,var(--xs-line));border-radius:var(--moe-radius-lg,1rem)}.impact-card p:last-child{margin:.55rem 0 0;line-height:1.65}.impact-icon{display:grid;place-items:center;width:4rem;height:4rem;border-radius:50%;color:var(--moe-on-accent);background:var(--moe-accent-strong);font:800 .95rem var(--moe-font-family-mono,monospace)}.release-section{padding-block:clamp(3.5rem,7vw,6rem)}.acquisition-band,.migration-band{background:color-mix(in srgb,var(--moe-surface) 72%,transparent);border-block:1px solid var(--xs-line)}.section-heading{max-width:48rem;margin-bottom:2rem}.section-heading h2,.migration-layout h2{margin:.65rem 0 1rem;font-size:clamp(2rem,4.5vw,3.5rem);line-height:1.05;letter-spacing:-.045em}.section-heading>p:last-child{font-size:1.05rem;line-height:1.7}.download-grid,.highlight-grid,.change-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.download-grid article,.highlight-grid article,.change-groups article,.verification-grid article,.history-list article{padding:1.35rem;border:1px solid var(--xs-line);border-radius:var(--moe-radius-md,.75rem);background:color-mix(in srgb,var(--moe-background) 72%,transparent)}.platform-kind,.highlight-grid span{margin:0;color:var(--moe-text-soft);font:700 .7rem var(--moe-font-family-mono,monospace)}.download-grid h3{margin:.5rem 0 1rem;font-size:1.4rem}.download-actions{display:grid}.download-link{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.7rem;padding:.7rem;border:1px solid var(--xs-line);border-radius:var(--moe-radius-sm,.5rem);color:var(--moe-heading);font-weight:800}.download-link code{min-width:0;overflow-wrap:anywhere;color:var(--moe-text-soft);font-size:.63rem;font-weight:500}.download-link:hover{border-color:var(--moe-accent);background:var(--moe-accent-wash)}.verification-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:1rem;margin-top:1rem}.verification-grid p:last-child{margin-bottom:0;color:var(--moe-text-soft);font-size:.85rem;line-height:1.6}.verification-grid pre{margin:.7rem 0;padding:1rem;overflow-x:auto;border-radius:var(--moe-radius-sm,.5rem);color:var(--xs-code-text);background:var(--xs-code);white-space:pre-wrap;overflow-wrap:anywhere}.highlight-grid article{background:var(--moe-surface)}.highlight-grid h3{margin:.9rem 0 .5rem;font-size:1.25rem}.highlight-grid p,.change-groups li{color:var(--moe-text-soft);line-height:1.65}.change-groups{margin-top:1rem}.change-groups h3{font-size:1rem}.change-groups ul{padding-left:1.1rem}.migration-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,6vw,5rem);align-items:start}.migration-layout ol{margin:0;padding:0;list-style:none}.migration-layout li{display:grid;grid-template-columns:2.1rem 1fr;gap:.8rem;padding:1rem 0;border-bottom:1px solid var(--xs-line)}.migration-layout li>span{color:var(--moe-accent-strong);font:800 .7rem var(--moe-font-family-mono,monospace)}.migration-layout li p{margin:0}.compatibility{margin-top:2rem;padding-block:1.35rem;border-top:1px solid var(--xs-line)}.compatibility h3{margin-top:0}.compatibility p{max-width:52rem}.history-list{display:grid;gap:.8rem}.history-list article{display:grid;grid-template-columns:10rem 10rem 1fr auto;align-items:center;gap:1rem}.history-list article>div:first-child{display:flex;align-items:center;gap:.5rem}.version{font-size:1.2rem;font-weight:850}.history-list time{color:var(--moe-text-soft);font-size:.8rem}.history-list p{margin:0;line-height:1.55}.history-actions a{padding:.3rem .5rem;border-radius:.35rem;color:var(--moe-accent-strong);font-size:.75rem;font-weight:780}.history-actions a:hover{background:var(--moe-accent-wash)}@media(max-width:900px){.release-hero,.migration-layout{grid-template-columns:1fr}.download-grid,.highlight-grid,.change-groups{grid-template-columns:1fr 1fr}.history-list article{grid-template-columns:8rem 1fr}.history-list article p,.history-actions{grid-column:1/-1}}@media(max-width:640px){.release-hero{padding-block:3rem}.download-grid,.highlight-grid,.change-groups,.verification-grid{grid-template-columns:1fr}.actions .button{width:100%}.history-list article{grid-template-columns:1fr}.history-list article p,.history-actions{grid-column:auto}.history-actions{display:grid}.history-actions a{min-height:2.3rem;display:flex;align-items:center}.impact-card{grid-template-columns:1fr}.impact-icon{width:3.3rem;height:3.3rem}}@media(prefers-reduced-motion:reduce){.button:hover,.resource-link:hover{transform:none}}
</style>
