---
import ProductShell from "./ProductShell.astro";
import type { Locale } from "../i18n/messages";
import type { LocalizedPaths } from "../i18n/routes";

/** Optional editorial outline entry. / 可选的编辑型文章提纲条目。 */
export interface ReleaseOutlineItem { href: `#${string}`; label: string; }
/** Adjacent immutable release. / 相邻的不可变发布。 */
export interface ReleaseNeighbour { href: string; label: string; }

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath?: string;
  alternatePaths?: Partial<LocalizedPaths>;
  languageSwitchHref?: string;
  releaseMetadataPath?: string | null;
  releaseVersion?: string;
  variant?: "index" | "story";
  eyebrow: string;
  heading: string;
  dek: string;
  backHref?: string;
  backLabel?: string;
  outline?: ReadonlyArray<ReleaseOutlineItem>;
  outlineLabel?: string;
  factsLabel?: string;
  previous?: ReleaseNeighbour;
  next?: ReleaseNeighbour;
  previousLabel?: string;
  nextLabel?: string;
  allHref?: string;
  allLabel?: string;
}
const { locale, title, description, canonicalPath, alternatePaths, languageSwitchHref,
  releaseMetadataPath, releaseVersion, variant = "story", eyebrow, heading, dek, backHref,
  backLabel, outline = [], outlineLabel, factsLabel, previous, next, previousLabel, nextLabel,
  allHref, allLabel } = Astro.props;
---

<ProductShell locale={locale} page="releases" {title} {description} {canonicalPath} {alternatePaths}
  {languageSwitchHref} {releaseMetadataPath} {releaseVersion}>
  <slot name="head" slot="head" />
  <main id="main" class:list={["release-layout", `release-${variant}`]}>
    <header class="release-masthead release-width">
      {backHref && <a class="release-back" href={backHref}><span aria-hidden="true">←</span>{backLabel}</a>}
      <p class="release-eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="release-dek">{dek}</p>
      <div class="release-factline"><slot name="factline" /></div>
      <div class="release-actions"><slot name="actions" /></div>
    </header>

    {variant === "index" ? <div class="release-index-body release-width"><slot /></div> : <>
      <div class="release-story-grid release-width">
        <article class="release-article"><slot /></article>
        <aside class="release-story-rail">
          {outline.length > 0 && <nav aria-label={outlineLabel}><strong>{outlineLabel}</strong>{outline.map((item) => <a href={item.href}>{item.label}</a>)}</nav>}
          <section class="release-facts" aria-label={factsLabel}><strong>{factsLabel}</strong><slot name="facts" /></section>
          <div class="release-resources"><slot name="resources" /></div>
        </aside>
      </div>
      <nav class="release-pagination release-width" aria-label={allLabel}>
        <div>{previous && <a rel="prev" href={previous.href}><span>{previousLabel}</span><strong>{previous.label}</strong></a>}</div>
        {allHref && <a class="all-releases" href={allHref}>{allLabel}</a>}
        <div>{next && <a rel="next" href={next.href}><span>{nextLabel}</span><strong>{next.label}</strong></a>}</div>
      </nav>
    </>}
  </main>
</ProductShell>

<style is:global>
  .release-width{width:min(100% - 3rem,78rem);margin-inline:auto}.release-layout{min-height:70vh}.release-masthead{padding-block:clamp(2.2rem,5vw,4.5rem) 2.7rem;border-bottom:1px solid var(--xs-line)}.release-back{display:inline-flex;align-items:center;gap:.5rem;padding:.3rem .45rem;margin:0 0 1.7rem -.45rem;border-radius:.35rem;color:var(--moe-text-soft);font-size:.78rem;font-weight:750}.release-back:hover{color:var(--moe-accent-strong);background:var(--moe-accent-wash)}.release-eyebrow{margin:0 0 .75rem;color:var(--moe-accent-strong);font:850 .7rem var(--moe-font-family-mono,monospace);letter-spacing:.14em;text-transform:uppercase}.release-masthead h1{max-width:57rem;margin:0;font-family:Georgia,"Noto Serif SC",serif;font-size:clamp(2.45rem,5.5vw,4.8rem);font-weight:700;line-height:1.04;letter-spacing:-.045em}.release-dek{max-width:54rem;margin:1.2rem 0 0;color:var(--moe-text-soft);font-family:Georgia,"Noto Serif SC",serif;font-size:clamp(1rem,1.8vw,1.18rem);line-height:1.72}.release-factline,.release-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.55rem}.release-factline{margin-top:1.25rem;color:var(--moe-text-soft);font:700 .7rem var(--moe-font-family-mono,monospace)}.release-factline:empty,.release-actions:empty{display:none}.release-actions{margin-top:1.15rem}.release-actions>a{display:inline-flex;align-items:center;gap:.45rem;min-height:2.5rem;padding:.5rem .75rem;border:1px solid var(--xs-line);border-radius:.4rem;color:var(--moe-heading);font-size:.75rem;font-weight:800}.release-actions>a:hover{border-color:var(--moe-accent);color:var(--moe-accent-strong);background:var(--moe-accent-wash)}
  .release-story-grid{display:grid;grid-template-columns:minmax(0,52rem) 13rem;justify-content:space-between;gap:clamp(2.5rem,7vw,7rem);padding-block:3.5rem 5rem}.release-article{min-width:0;overflow-wrap:anywhere;font-family:Georgia,"Noto Serif SC",serif}.release-article>section{padding-bottom:3.5rem;scroll-margin-top:6rem}.release-article>section+section{padding-top:3.5rem;border-top:1px solid var(--xs-line)}.release-story-rail{min-width:0;overflow-wrap:anywhere;position:sticky;top:5.2rem;align-self:start;min-width:0;font-family:var(--moe-font-family-sans,sans-serif);font-size:.75rem}.release-story-rail nav,.release-facts,.release-resources{display:grid;gap:.25rem;padding-bottom:1.2rem}.release-story-rail nav+section,.release-facts+.release-resources{padding-top:1.2rem;border-top:1px solid var(--xs-line)}.release-story-rail strong{margin-bottom:.35rem;color:var(--moe-heading);font:800 .65rem var(--moe-font-family-mono,monospace);letter-spacing:.07em;text-transform:uppercase}.release-story-rail a{padding:.38rem .45rem;margin-inline:-.45rem;border-radius:.3rem;color:var(--moe-text-soft);line-height:1.4}.release-story-rail a:hover{color:var(--moe-accent-strong);background:var(--moe-accent-wash)}.release-facts dl{margin:0}.release-facts dl>div{padding:.65rem 0;border-bottom:1px solid var(--xs-line)}.release-facts dt{color:var(--moe-text-soft);font-size:.62rem}.release-facts dd{margin:.2rem 0 0;color:var(--moe-heading);line-height:1.45}
  .release-index-body{padding-block:2rem 5.5rem}.release-index .release-masthead{padding-block:clamp(2.6rem,6vw,4.8rem) 2.1rem}.release-index .release-masthead h1{font-size:clamp(2.5rem,5vw,4.25rem)}
  .release-pagination{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;padding-block:1.6rem 3rem;border-top:1px solid var(--xs-line)}.release-pagination>div:last-child{text-align:right}.release-pagination a{display:inline-grid;gap:.15rem;padding:.45rem .6rem;border-radius:.4rem;color:var(--moe-heading)}.release-pagination a:hover{color:var(--moe-accent-strong);background:var(--moe-accent-wash)}.release-pagination span{color:var(--moe-text-soft);font-size:.62rem}.all-releases{font-size:.75rem;font-weight:800}
  @media(max-width:820px){.release-width{width:min(100% - 2rem,76rem)}.release-story-grid{grid-template-columns:1fr;padding-top:2rem}.release-story-rail{min-width:0;overflow-wrap:anywhere;position:static;grid-row:1;display:grid;grid-template-columns:1fr 1fr;gap:1rem}.release-resources{grid-column:1/-1}.release-masthead h1{font-size:clamp(2.3rem,9vw,3.7rem)}}
  @media(max-width:520px){.release-width{width:calc(100% - 1.25rem)}.release-story-rail{grid-template-columns:1fr}.release-resources{grid-column:auto}.release-pagination{grid-template-columns:1fr 1fr}.all-releases{grid-column:1/-1;grid-row:1;text-align:center}.release-pagination>div{grid-row:2}.release-pagination>div:last-child{text-align:right}}
</style>
