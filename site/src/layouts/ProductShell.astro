---
import BaseLayout from "./BaseLayout.astro";
import ThemeControl from "../components/ThemeControl";
import { messages, type Locale } from "../i18n/messages";
import { paths, type Page } from "../i18n/routes";

/** Shared product chrome for every human-facing route.
 * 所有人类可读页面共用的产品外壳。 */
interface Props {
  locale: Locale;
  page: Page;
  title?: string;
  description?: string;
}

const { locale, page, title, description } = Astro.props;
const m = messages[locale];
const other: Locale = locale === "zh-CN" ? "en" : "zh-CN";
const repo = "https://github.com/kleedaisuki/prompt-squish";
const navItems: Array<{ page: Page; label: string }> = [
  { page: "home", label: m.reference.nav.home },
  { page: "releases", label: m.reference.nav.releases },
  { page: "namespace", label: m.reference.nav.namespace },
];
---

<BaseLayout locale={locale} page={page} title={title} description={description}>
  <slot name="head" slot="head" />
  <header class="product-header">
    <div class="product-width header-primary">
      <a class="product-brand" href={paths[locale].home} aria-label="xmlsquish">
        <img src="/favicon.svg" alt="" width="38" height="38" />
        <span><strong>xmlsquish</strong><small>source. compose. build.</small></span>
      </a>
      <div class="header-actions">
        <a class="language-link" href={paths[other][page]} lang={other} hreflang={other}>{m.nav.language}</a>
        <ThemeControl client:load labels={m.theme} />
        <a class="github-link" href={repo} aria-label={m.nav.github}>
          <svg viewBox="0 0 24 24" width="21" height="21" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.4 11.4 0 0 0-3.6 22.2c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.4-1.3-5.4-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.4 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.4 11.4 0 0 0 12 .8Z"/></svg>
        </a>
      </div>
    </div>
    <nav class="product-width product-nav" aria-label={m.reference.nav.label}>
      {navItems.map((item) => <a href={paths[locale][item.page]} aria-current={item.page === page ? "page" : undefined}>{item.label}</a>)}
    </nav>
  </header>
  <slot />
  <footer class="product-footer">
    <div class="product-width footer-inner">
      <span><strong>xmlsquish</strong> · source. compose. build.</span>
      <nav aria-label={m.reference.nav.footerLabel}>
        <a href="https://style.moesegfault.dev/">{m.footer.style} <span aria-hidden="true">✦</span></a>
        <a href="/LICENSE.txt" rel="license">{m.footer.license}</a>
        <a href="/THIRD_PARTY_NOTICES.txt">{m.footer.notices}</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<style is:global>
  .product-width { width:min(100% - 3rem,76rem);margin-inline:auto }
  .product-header { position:sticky;z-index:20;top:0;border-bottom:1px solid var(--xs-line);background:color-mix(in srgb,var(--moe-background,#fff9f0) 92%,transparent);backdrop-filter:blur(16px) }
  .header-primary { min-height:4.15rem;display:flex;align-items:center;justify-content:space-between;gap:1rem }
  .product-brand { display:flex;align-items:center;gap:.65rem;flex-shrink:0;color:var(--moe-heading) }
  .product-brand span { display:grid;gap:.1rem }.product-brand strong{font-size:1.25rem;letter-spacing:-.04em}.product-brand small{font:.62rem var(--moe-font-family-mono,monospace);color:var(--moe-text-soft)}
  .header-actions,.product-nav,.footer-inner nav{display:flex;align-items:center;gap:1rem}.header-actions{flex-shrink:0}
  .product-nav { min-height:2.7rem;justify-content:center;border-top:1px solid color-mix(in srgb,var(--xs-line) 55%,transparent) }
  .product-nav a,.language-link { min-height:2.1rem;display:inline-flex;align-items:center;padding-inline:.7rem;border-radius:999px;color:var(--moe-text-soft);font-size:.83rem;font-weight:700 }
  .product-nav a:hover,.language-link:hover { color:var(--moe-accent-strong);background:var(--moe-accent-wash) }
  .product-nav a[aria-current="page"] { color:var(--moe-accent-strong);background:var(--moe-accent-wash);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--moe-accent) 28%,transparent) }
  .github-link{min-width:2.1rem;min-height:2.1rem;display:grid;place-items:center;border-radius:50%;color:var(--moe-heading)}.github-link:hover{color:var(--moe-accent-strong);background:var(--moe-accent-wash)}
  .product-footer{border-top:1px solid var(--xs-line)}.footer-inner{display:flex;justify-content:space-between;gap:1.5rem;padding-block:1.5rem;color:var(--moe-text-soft);font-size:.7rem}.footer-inner nav{flex-wrap:wrap}.footer-inner a:hover{color:var(--moe-accent-strong);background:var(--moe-accent-wash)}
  .product-header a,.product-footer a,main a,.product-header a:hover,.product-footer a:hover,main a:hover,.product-header a:focus,.product-footer a:focus,main a:focus,.product-header a:visited,.product-footer a:visited,main a:visited { text-decoration:none }
  main .text-link { display:inline-flex;align-items:center;gap:.25rem;padding:.16rem .35rem;margin-inline:-.35rem;border-radius:.35rem;color:var(--moe-accent-strong);font-weight:750 }
  main .text-link:hover { background:var(--moe-accent-wash) }
  @media(max-width:640px){.product-width{width:min(100% - 2rem,76rem)}.header-primary{min-height:4rem}.product-brand small{display:none}.header-actions{gap:.35rem}.language-link{padding-inline:.45rem}.product-nav{justify-content:stretch;gap:.25rem;overflow-x:auto;padding-block:.3rem}.product-nav a{flex:1;justify-content:center;white-space:nowrap;padding-inline:.35rem;font-size:.75rem}.footer-inner{display:grid}.footer-inner nav{gap:.65rem}}
  @media(max-width:360px){.product-brand span{display:none}.product-brand{gap:0}.header-actions{min-width:0}.language-link{font-size:.75rem}}
</style>
