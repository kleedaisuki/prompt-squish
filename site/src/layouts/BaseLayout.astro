---
import type { Locale } from "../i18n/messages";
import { messages } from "../i18n/messages";
import { localizedPathsFor, type LocalizedPaths, type Page } from "../i18n/routes";
import { latestRelease } from "../data/releases";

interface Props {
  locale: Locale;
  /** Page metadata; defaults remain the landing page. / 页面元数据，默认保持首页。 */
  title?: string;
  description?: string;
  page?: Page;
  /** Override the current document URL without changing the active top-level navigation item.
   * 覆盖当前文档 URL，但不改变激活的顶层导航项。
   */
  canonicalPath?: string;
  /** Localized equivalents for detail routes such as a versioned release log.
   * 详情路由（例如版本化发布记录）的多语言对应路径。
   */
  alternatePaths?: Partial<LocalizedPaths>;
  /** Machine-readable metadata linked by a release surface; `null` explicitly omits it.
   * 发布页面关联的机器可读元数据；使用 `null` 可显式省略。
   */
  releaseMetadataPath?: string | null;
  /** Version named by release-detail social metadata. / 发布详情社交元数据所指的版本。 */
  releaseVersion?: string;
}

const {
  locale,
  title,
  description,
  page = "home",
  canonicalPath,
  alternatePaths,
  releaseMetadataPath,
  releaseVersion,
} = Astro.props;
const m = messages[locale];
const defaultPaths = localizedPathsFor(page);
const localizedPaths: LocalizedPaths = {
  "zh-CN": alternatePaths?.["zh-CN"] ?? defaultPaths["zh-CN"],
  en: alternatePaths?.en ?? defaultPaths.en,
};
const resolvedCanonicalPath = canonicalPath ?? localizedPaths[locale];
const pageTitle = title ?? m.meta.title;
const pageDescription = description ?? m.meta.description;
const canonical = new URL(resolvedCanonicalPath, Astro.site);
const hasSocialCard = page === "home" || page === "releases";
const socialImage = new URL(page === "releases" ? "/release-v1.png" : "/social-card.png", Astro.site);
const socialImageAlt = page === "releases"
  ? releaseVersion
    ? locale === "zh-CN"
      ? `xmlsquish ${releaseVersion}：XML 提示词项目管理器发布详情`
      : `xmlsquish ${releaseVersion}: XML prompt project manager release details`
    : locale === "zh-CN"
      ? "xmlsquish 发布记录：版本历史与变更日志"
      : "xmlsquish release log: version history and changelogs"
  : locale === "zh-CN"
    ? "xmlsquish：组织多文件 XML 源码，构建可检查的提示词产物"
    : "xmlsquish: compose multi-file XML sources into inspectable prompt artifacts";
// `undefined` preserves the release-index contract; `null` explicitly states that a historical
// detail has no machine document. / `undefined` 保留发布目录合同，`null` 显式表示历史详情无机器文档。
const releaseMetadataSource = page === "releases"
  ? releaseMetadataPath === undefined ? latestRelease.metadataPath : releaseMetadataPath
  : null;
const releaseMetadata = releaseMetadataSource ? new URL(releaseMetadataSource, Astro.site) : undefined;
/**
 * Keep product claims factual and rating-free; release availability lives in the machine contract.
 * 仅声明可核实的产品事实，不伪造评分；发布可用性以机器合同为准。
 */
// The release component owns its versioned SoftwareApplication entity; never emit a duplicate here.
// 发布组件独占版本化 SoftwareApplication 实体，此处不重复输出。
const productJsonLd = page === "home" ? {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": new URL("/#xmlsquish", Astro.site).href,
  name: "xmlsquish",
  description: pageDescription,
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "XML prompt project manager and compiler",
  operatingSystem: "Windows, Linux, macOS",
  softwareVersion: latestRelease.version,
  isAccessibleForFree: true,
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  sameAs: "https://github.com/kleedaisuki/prompt-squish",
  inLanguage: locale,
} : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#e66a3f" />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {hasSocialCard && <>
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={socialImageAlt} />
    </>}
    <meta property="og:locale" content={locale === "zh-CN" ? "zh_CN" : "en_US"} />
    <meta name="twitter:card" content={hasSocialCard ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {hasSocialCard && <>
      <meta name="twitter:image" content={socialImage} />
      <meta name="twitter:image:alt" content={socialImageAlt} />
    </>}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(localizedPaths["zh-CN"], Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(localizedPaths.en, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPaths["zh-CN"], Astro.site)} />
    {releaseMetadata && <link rel="alternate" type="application/json" title={`xmlsquish ${releaseVersion ?? latestRelease.version} release metadata`} href={releaseMetadata} />}
    <link rel="alternate" type="text/plain" title="Experimental llms.txt agent navigation" href={new URL("/llms.txt", Astro.site)} />
    {productJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd).replaceAll("<", "\\u003c")} />}
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://style.moesegfault.dev/v0.1.2/css/all.css"
      integrity="sha384-Tsj7ndpNmGrJTPrbAcVgLnpddldDQeHjlbEZRTpJmfvqM6xgXNrrqmsYK61doSFn"
      crossorigin="anonymous"
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("xmlsquish-theme");
          if (saved === "light" || saved === "dark" || saved === "auto") {
            document.documentElement.dataset.moeTheme = saved;
          }
        } catch { /* Storage may be unavailable; the system theme still works. */ }
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === "zh-CN" ? "跳到主要内容" : "Skip to content"}</a>
    <slot />
  </body>
</html>

<style is:global>
  @layer xmlsquish {
    :root {
      --xs-line: color-mix(in srgb, var(--moe-border) 72%, transparent);
      --xs-glow: color-mix(in srgb, var(--moe-accent) 22%, transparent);
      --xs-code: color-mix(in srgb, var(--moe-color-brown-900) 94%, var(--moe-accent));
      --xs-code-text: var(--moe-color-cream-200);
      --xs-max: 73.75rem;
    }

    :root[data-moe-theme="dark"] {
      --xs-code: color-mix(in srgb, var(--moe-color-brown-900) 82%, black);
    }

    body {
      margin: 0;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    a,
    a:hover,
    a:focus,
    a:visited {
      text-decoration: none;
    }

    .skip-link {
      position: fixed;
      z-index: 100;
      inset: var(--moe-space-3) auto auto var(--moe-space-3);
      padding: var(--moe-space-2) var(--moe-space-3);
      border-radius: var(--moe-radius-sm);
      color: var(--moe-on-accent);
      background: var(--moe-accent-strong);
      transform: translateY(-180%);
      text-decoration: none;
    }

    .skip-link:focus {
      transform: translateY(0);
    }
    a:focus-visible, button:focus-visible, summary:focus-visible {
      outline: 3px solid var(--moe-accent-strong);
      outline-offset: 4px;
    }
  }
</style>
