---
import type { Locale } from "../i18n/messages";
import { messages } from "../i18n/messages";
import { paths, type Page } from "../i18n/routes";

interface Props {
  locale: Locale;
  /** Page metadata; defaults remain the landing page. / 页面元数据，默认保持首页。 */
  title?: string;
  description?: string;
  page?: Page;
}

const { locale, title, description, page = "home" } = Astro.props;
const m = messages[locale];
const canonicalPath = paths[locale][page];
const pageTitle = title ?? m.meta.title;
const pageDescription = description ?? m.meta.description;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL("/social-card.png", Astro.site);
const socialImageAlt = locale === "zh-CN"
  ? "xmlsquish：组织多文件 XML 源码，构建可检查的提示词产物"
  : "xmlsquish: compose multi-file XML sources into inspectable prompt artifacts";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#e66a3f" />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {page === "home" && <>
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={socialImageAlt} />
    </>}
    <meta property="og:locale" content={locale === "zh-CN" ? "zh_CN" : "en_US"} />
    <meta name="twitter:card" content={page === "home" ? "summary_large_image" : "summary"} />
    {page === "home" && <meta name="twitter:image" content={socialImage} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(paths["zh-CN"][page], Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(paths.en[page], Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(paths["zh-CN"][page], Astro.site)} />
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://style.moesegfault.dev/v0.1.1/css/all.css"
      integrity="sha384-sAbt4aFsZmeAtLPp+2KJShrwxa3361+DAzHTcDNGRVCNw+KNoYQH0JIIpdTddTjh"
      crossorigin="anonymous"
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("xmlsquish-theme");
          if (saved === "light" || saved === "dark" || saved === "auto") {
            document.documentElement.dataset.moeTheme = saved;
          }
        } catch { /* Storage may be unavailable; the system theme still works. */ }
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === "zh-CN" ? "跳到主要内容" : "Skip to content"}</a>
    <slot />
  </body>
</html>

<style is:global>
  @layer xmlsquish {
    :root {
      --xs-line: color-mix(in srgb, var(--moe-border) 72%, transparent);
      --xs-glow: color-mix(in srgb, var(--moe-accent) 22%, transparent);
      --xs-code: color-mix(in srgb, var(--moe-color-brown-900) 94%, var(--moe-accent));
      --xs-code-text: var(--moe-color-cream-200);
      --xs-max: 73.75rem;
    }

    :root[data-moe-theme="dark"] {
      --xs-code: color-mix(in srgb, var(--moe-color-brown-900) 82%, black);
    }

    body {
      margin: 0;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    .skip-link {
      position: fixed;
      z-index: 100;
      inset: var(--moe-space-3) auto auto var(--moe-space-3);
      padding: var(--moe-space-2) var(--moe-space-3);
      border-radius: var(--moe-radius-sm);
      color: var(--moe-on-accent);
      background: var(--moe-accent-strong);
      transform: translateY(-180%);
    }

    .skip-link:focus {
      transform: translateY(0);
    }
    a:focus-visible, button:focus-visible, summary:focus-visible {
      outline: 3px solid var(--moe-accent-strong);
      outline-offset: 4px;
    }
  }
</style>
