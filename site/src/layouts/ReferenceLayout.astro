---
import BaseLayout from "./BaseLayout.astro";

/** Shared release and namespace reference shell. / 发布与命名空间文档共用阅读布局。 */
interface Props { title: string; description: string; path: string; }
const { title, description, path } = Astro.props;
---
<BaseLayout locale="en" title={title} description={description} canonicalPath={path}>
  <slot name="head" slot="head" />
  <header class="reference-header">
    <a class="reference-brand" href="/"><img src="/favicon.svg" alt="" width="32" height="32" />xmlsquish</a>
    <nav aria-label="Reference navigation"><a href="/releases/">Releases / 发布</a><a href="/ns">Namespace / 命名空间</a><a href="https://github.com/kleedaisuki/prompt-squish">GitHub</a></nav>
  </header>
  <main id="main" class="reference-content"><slot /></main>
  <footer class="reference-footer"><a href="/LICENSE.txt" rel="license">GPL-3.0-or-later</a> · Maintained by the xmlsquish project / 由 xmlsquish 项目维护</footer>
</BaseLayout>
<style is:global>
  .reference-header, .reference-content, .reference-footer { max-width: 64rem; margin-inline: auto; padding: 1.5rem; }
  .reference-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--moe-border, #bbb); }
  .reference-brand { display: inline-flex; gap: .6rem; align-items: center; font-weight: 800; text-decoration: none; }
  .reference-header nav { display: flex; flex-wrap: wrap; gap: 1rem; }
  .reference-content { line-height: 1.8; overflow-wrap: anywhere; }
  .reference-content h1 { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.15; margin-block: 1.5rem; }
  .reference-content h2 { margin-top: 2.5rem; line-height: 1.3; }
  .reference-content pre { padding: 1rem; overflow-x: auto; border: 1px solid var(--moe-border, #bbb); border-radius: .5rem; }
  .reference-content code { font-size: .9em; }
  .reference-content table { width: 100%; border-collapse: collapse; }
  .reference-content th, .reference-content td { padding: .6rem; text-align: left; border-bottom: 1px solid var(--moe-border, #bbb); vertical-align: top; }
  .reference-content .identity { padding: 1rem; border-left: .3rem solid var(--moe-accent, #e66a3f); background: var(--moe-surface, #eee); }
  .reference-content .identity code { font-size: .8rem; letter-spacing: normal; }
  .reference-content tr[id] td:first-child code { white-space: nowrap; }
  .reference-footer { font-size: .875rem; border-top: 1px solid var(--moe-border, #bbb); }
</style>
