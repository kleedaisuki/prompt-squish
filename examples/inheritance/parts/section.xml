<xs:module xmlns:xs="https://xmlsquish.moesegfault.dev/ns" xmlns:p="https://example.com/macros/sections">
  <xs:import src="./leaf.xml"/>
  <xs:macro name="p:section">
    <xs:param name="audience"/>
    <Section>
      <xs:slot name="heading" required="true"/>
      <xs:expand ref="p:leaf"><xs:arg name="audience" get="arg.audience"/></xs:expand>
    </Section>
  </xs:macro>
</xs:module>
