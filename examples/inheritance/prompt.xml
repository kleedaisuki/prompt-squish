<?xmlsquish author="klee" audience="researchers"?>
<prompt>
    <!-- 每条引用边独立指定；连续 parent 可传递元数据。 -->
    <!-- Each include decides independently; consecutive parent edges propagate metadata. -->
    <xmlsquish:mount path="parts/section.xml" openat="parent"/>
    <xmlsquish:mount path="parts/section.xml" openat="self"/>
    <xmlsquish:let message="Hello &amp; welcome, &lt;researcher&gt;!"/>
    <message><xmlsquish:insert get="message"/></message>
    <xmlsquish:ifr str="$file:name" pattern="^prompt\.xml$">
        <matched>The physical filename matches.</matched>
    </xmlsquish:ifr>
</prompt>
